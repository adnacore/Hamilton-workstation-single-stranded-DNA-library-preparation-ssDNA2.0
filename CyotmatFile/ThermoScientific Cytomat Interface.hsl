        strParameter = IStr(i_intStoragePosition);
        if(!_SendCommand(i_intModuleID, LL_SHAKER_STOP, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to stop tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE); 
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // TowerShakerStop

    // --------------------------------------------------------------------------------------
    // function TowerShakerOpenClamp
    // --------------------------------------------------------------------------------------
    function TowerShakerOpenClamp(variable i_intModuleID,
                                  variable i_intStoragePosition) variable
    {
      variable strFunctionName("TowerShakerOpenClamp");
      variable intTosParameter(0), intCurrentDevice(0);
      variable strResponse(""), strParameter("");
      string strTempResponse("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStoragePosition,
                                                 "i_intStoragePosition",
                                                 0,
                                                 18,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intStoragePosition = " + IStr(i_intStoragePosition),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanShake, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // if i_intStoragePosition is set to 0, clamps of all available ToS are opened
      if(i_intStoragePosition == 0)
      {
        if(!_SendCommand(i_intModuleID, LL_CLAMP_OPEN, "", TIMEOUT_LONG, "", strFunctionName, "Unable to open clamping of tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      }
      else
      {
        strParameter = IStr(i_intStoragePosition);
        if(!_SendCommand(i_intModuleID, LL_CLAMP_OPEN, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to open clamping of tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE); 
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // TowerShakerOpenClamp

