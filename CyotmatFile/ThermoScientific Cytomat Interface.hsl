    //----------------------------------------------------------------------------------------------
    // private functions
    //----------------------------------------------------------------------------------------------
    //----------------------------------------------------------------------------------------------
    //private function _CheckState
    //----------------------------------------------------------------------------------------------
    private function _CheckState(variable i_intModuleID,
                                 variable& o_blnBusy,
                                 variable& o_blnReady,
                                 variable& o_blnWarning,
                                 variable& o_blnError,
                                 variable& o_blnHandler,
                                 variable& o_blnGate,
                                 variable& o_blnDoor,
                                 variable& o_blnTransfer,
                                 variable i_strCallingFunctionName) variable
    {
      variable strResponse("");
      string strTemp("");
      variable intStatusByte(0);
      variable strProcessedResponse("");

      i_strCallingFunctionName = i_strCallingFunctionName + ">_CheckState";

      if(!_SendCommand(i_intModuleID, CMD_STATUS, "", TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to check state", strResponse)) return(hslFalse);
      if(!_ProcessResponse(i_intModuleID, strResponse, "bs", ResponseType::STRING, strProcessedResponse, i_strCallingFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      intStatusByte = IVal("0x" + strProcessedResponse);

      if(intStatusByte & 0x01) o_blnBusy = hslTrue; else o_blnBusy = hslFalse;
      if(intStatusByte & 0x02) o_blnReady = hslTrue; else o_blnReady = hslFalse;
      if(intStatusByte & 0x04) o_blnWarning = hslTrue; else o_blnWarning = hslFalse;
      if(intStatusByte & 0x08) o_blnError = hslTrue; else o_blnError = hslFalse;
      if(intStatusByte & 0x10) o_blnHandler = hslTrue; else o_blnHandler = hslFalse;
      if(intStatusByte & 0x20) o_blnGate = hslTrue; else o_blnGate = hslFalse;
      if(intStatusByte & 0x40) o_blnDoor = hslTrue; else o_blnDoor = hslFalse;
      if(intStatusByte & 0x80) o_blnTransfer = hslTrue; else o_blnTransfer = hslFalse;

      if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                          TRACE_LEVEL_DEBUG,
                                          "strResponse = '" + strResponse + "'" +
                                          ", intStatusByte = " + IStr(intStatusByte) +
                                          ", --> o_blnBusy = " + IStr(o_blnBusy) +
                                          ", --> o_blnReady = " + IStr(o_blnReady) +
                                          ", --> o_blnWarning = " + IStr(o_blnWarning) +
                                          ", --> o_blnError = " + IStr(o_blnError) +
                                          ", --> o_blnHandler = " + IStr(o_blnHandler) +
                                          ", --> o_blnGate = " + IStr(o_blnGate) +
                                          ", --> o_blnDoor = " + IStr(o_blnDoor) +
                                          ", --> o_blnTransfer = " + IStr(o_blnTransfer),
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
      }

      return(hslTrue);
    } // _CheckState

    // --------------------------------------------------------------------------------------
    // private function _WaitForReady
    // --------------------------------------------------------------------------------------
    private function _WaitForReady(variable i_intModuleID,
                                   variable i_intTimeout,
                                   variable i_strStatusDescription,
                                   variable i_strCallingFunctionName) variable
    {
      timer hdlTimeout, gdlErrorResetTimout;
      const variable fltResetTimout(15.0);
      variable blnBusy(hslTrue), blnReady(hslFalse), blnWarning(hslFalse), blnError(hslFalse), blnHandler(hslFalse), blnGate(hslFalse), blnDoor(hslFalse), blnTransfer(hslFalse);
      variable strResponse("");
      variable strError(""), strErrorMessage("");
      variable intCurrentTraceLevel;

      i_strCallingFunctionName = i_strCallingFunctionName + ">_WaitForReady";

      hdlTimeout.SetTimer(hslInfinite);
      
      while(hdlTimeout.GetElapsedTime() < i_intTimeout)
      {
        if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
        {
          Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::PROGRESS,
                                            TRACE_LEVEL_DEBUG,
                                            i_strStatusDescription,
                                            i_strCallingFunctionName,
                                            gThermoScientific_Cytomat_Interface_intTraceLevel,
                                            gThermoScientific_Cytomat_Interface_strModuleName);
        }
        Hamilton_DriverTools::Delay(1.0, i_strCallingFunctionName, gThermoScientific_Cytomat_Interface_strModuleName);
        
        if(!_CheckState(i_intModuleID, blnBusy, blnReady, blnWarning, blnError, blnHandler, blnGate, blnDoor, blnTransfer, i_strCallingFunctionName)) return(hslFalse);
        if(blnError == hslTrue) break;
        if(blnBusy == hslFalse) return(hslTrue);
      }

      if(!_SendCommand(i_intModuleID, CMD_ERROR_STATUS, "", TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to retrieve error status", strError)) return(hslFalse);

      if(blnError == hslTrue) strErrorMessage = "Error occured with the following response: '";
      else strErrorMessage = "Timeout reached while waiting for device to be ready! Error response: '";

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                              TRACE_LEVEL_RELEASE,
                              strErrorMessage + _HandleErrorMessage(strError) + "'",
                              i_strCallingFunctionName,
                              gThermoScientific_Cytomat_Interface_intTraceLevel,
                              gThermoScientific_Cytomat_Interface_strModuleName);

      return(hslFalse);
    } // _WaitForReady

    //----------------------------------------------------------------------------------------------
    //private function _SendCommand
    //----------------------------------------------------------------------------------------------
    private function _SendCommand(variable i_intModuleID,
                                  variable i_strCommand,
                                  variable i_strParameter,
                                  variable i_fltTimeout,
                                  variable i_strExpectedResponse,
                                  variable i_strCallingFunctionName,
                                  variable i_strErrorDescription,
                                  variable& o_strResponse) variable
    {
      variable strCommand("");
      variable blnWaitForFinish(hslTrue);
      variable intSerialModuleID(0);

      i_strCallingFunctionName = i_strCallingFunctionName + ">_SendCommand";

      if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
      {
        // Parameter 'i_strErrorDescription' is not traced since it should only be traced in case of an error!
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                          TRACE_LEVEL_RELEASE,
                                          "i_intModuleID = " + IStr(i_intModuleID) +
                                          ", i_strCommand = '" + i_strCommand + "'" +
                                          ", i_strParameter = '" + i_strParameter + "'" +
                                          ", i_fltTimeout = " + FStr(i_fltTimeout) +
                                          ", i_strExpectedResponse = '" + i_strExpectedResponse + "'",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
      }
      // Access the module ID generated from the serial interface
      intSerialModuleID = gThermoScientific_Cytomat_Interface_arrIntSerialModuleIDs.GetAt(i_intModuleID);

      if(i_strParameter == "") strCommand = i_strCommand; else strCommand = i_strCommand + " " + i_strParameter;

      if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::PROGRESS,
                                          TRACE_LEVEL_RELEASE,
                                          "Sending '" + strCommand + "'",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
      }

      if(Hamilton_SerialInterface::SendDeviceCommandSilent(intSerialModuleID, strCommand) == ASWGLOBAL::BOOL::FALSE)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          i_strErrorDescription +
                                          ": Error while sending command '" + strCommand + "'!",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(hslFalse);
      }

      if(Hamilton_SerialInterface::ReceiveDeviceAnswerSilent(intSerialModuleID, i_fltTimeout, o_strResponse) == ASWGLOBAL::BOOL::FALSE)
      {
        
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          i_strErrorDescription + 
                                          ": Unable to read response for command '" + strCommand + "'!",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(hslFalse);
      }
      
      // check if an error was returned
      if(!_CommandWasSuccessful(i_intModuleID, strCommand, o_strResponse, i_strCallingFunctionName)) return(hslFalse);
      
      if(i_strExpectedResponse != "" && o_strResponse != i_strExpectedResponse)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          "Unable to execute command '" + strCommand + "'",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(hslFalse);
      }

      if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                          TRACE_LEVEL_RELEASE,
                                          "o_strResponse = '" + o_strResponse + "'",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
      }
      return(hslTrue);
    } // _SendCommand

    //----------------------------------------------------------------------------------------------
    //private function _TerminateDevice
    //----------------------------------------------------------------------------------------------
    private function _TerminateDevice(variable i_intModuleID,
                                      variable i_strCallingFunctionName) variable
    {
      variable intSerialModuleID(0);

      i_strCallingFunctionName = i_strCallingFunctionName + ">_TerminateDevice";
      
      intSerialModuleID = gThermoScientific_Cytomat_Interface_arrIntSerialModuleIDs.GetAt(i_intModuleID);

      if(Hamilton_SerialInterface::TerminateDevice(intSerialModuleID) == ASWGLOBAL::BOOL::FALSE)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          "Unable to terminate device!",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(hslFalse);
      }
      return(hslTrue);
    } // _TerminateDevice

    //----------------------------------------------------------------------------------------------
    //private function _InitializeDevice
    //----------------------------------------------------------------------------------------------
    private function _InitializeDevice(variable i_intCOMPort,
                                       variable i_intCytomatType,
                                       variable i_blnSimulationMode,
                                       variable i_strCallingFunctionName,
                                       variable& o_intModuleID) variable
    {
      variable strDeviceName("");
      variable intSerialModuleID(0);

      i_strCallingFunctionName = i_strCallingFunctionName + ">_InitializeDevice";

      o_intModuleID = Hamilton_DriverTools::FindInArray(gThermoScientific_Cytomat_Interface_arrIntCOMPorts,
                                                        i_intCOMPort,
                                                        "Initialize",
                                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(o_intModuleID != -1) return (hslTrue);

      o_intModuleID = Hamilton_DriverTools::FindInArray(gThermoScientific_Cytomat_Interface_arrIntCOMPorts,
                                                        "- free -",
                                                        "Initialize",
                                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(o_intModuleID == -1)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          "All " + IStr(MAX_DEVICES) + " devices used !",
                                          "Initialize",
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(hslFalse);
      }
      
      if(i_intCytomatType == CytomatType::C2_LINEAR)  strDeviceName = "Cytomat 2 C-LiN";
      if(i_intCytomatType == CytomatType::C5)         strDeviceName = "Cytomat 5";
      if(i_intCytomatType == CytomatType::C10)        strDeviceName = "Cytomat 10";
      if(i_intCytomatType == CytomatType::C24)        strDeviceName = "Cytomat 24";
      
      if(!Hamilton_SerialInterface::InitializeDevice(i_intCOMPort,
                                                     "9600,N,8,1,N,CR",
                                                     strDeviceName,
                                                     i_blnSimulationMode,
                                                     intSerialModuleID))
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          "Unable to initialize device!",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(hslFalse);
      }
                                                     
      gThermoScientific_Cytomat_Interface_arrIntSerialModuleIDs.SetAt(o_intModuleID, intSerialModuleID);

      Hamilton_SerialInterface::SetTraceLevelSilent(intSerialModuleID, gThermoScientific_Cytomat_Interface_intTraceLevel);

      if(gThermoScientific_Cytomat_Interface_intTraceLevel == TRACE_LEVEL_DEBUG) Hamilton_SerialInterface::ShowUsage();
      
      // Array AvailableDevices is needed to access the stacker/level range of the different cytomat
      gThermoScientific_Cytomat_Interface_arrIntAvailableDevices.SetAt(o_intModuleID, i_intCytomatType);
      gThermoScientific_Cytomat_Interface_arrIntCOMPorts.SetAt(o_intModuleID, i_intCOMPort);
      gThermoScientific_Cytomat_Interface_arrStrCytomatTypes.SetAt(o_intModuleID, strDeviceName);
      gThermoScientific_Cytomat_Interface_arrBlnInitialized.SetAt(o_intModuleID, hslTrue);
      gThermoScientific_Cytomat_Interface_arrBlnSimulated.SetAt(o_intModuleID, i_blnSimulationMode);
      
      return(hslTrue);

    } // _InitializeDevice

    //----------------------------------------------------------------------------------------------
    //private function _GetDeviceType
    //----------------------------------------------------------------------------------------------
    private function _GetDeviceType(variable i_intModuleID,
                                    variable& o_strDeviceType,
                                    variable i_strCallingFunctionName) variable
    {
      variable strResponse("");
      string strDeviceType("");

      i_strCallingFunctionName = i_strCallingFunctionName + ">_GetDeviceType";

      if(!_SendCommand(i_intModuleID, CMD_DEVICETYPE, "", TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to get device type", strResponse)) return(hslFalse);
      if(!_ProcessResponse(i_intModuleID, strResponse, "dn", ResponseType::STRING, strDeviceType, i_strCallingFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      o_strDeviceType = strDeviceType;

      return(hslTrue);
    } // _GetDeviceType

    //----------------------------------------------------------------------------------------------
    //private function _GetEnvironmentValues
    //----------------------------------------------------------------------------------------------
    private function _GetEnvironmentValues(variable i_intModuleID,
                                           variable i_strMessage,
                                           variable i_strCommand,
                                           variable& o_intValueNominal,
                                           variable& o_intValueActual,
                                           variable i_strCallingFunctionName) variable
    {
      string strTemp("");

      i_strCallingFunctionName = i_strCallingFunctionName + ">_GetEnvironmentValue";

      strTemp = i_strMessage;
      // check for the correct response
      if(strTemp.Find(i_strCommand + " ") == -1)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          "Incorrect response of: '" + i_strMessage + "'",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(hslFalse);
      }
      o_intValueNominal = "42";
      o_intValueActual = "22";
      // cut 'ic ', 'ih ', 'io ' or 'it ' from the response
      strTemp = strTemp.Mid(strTemp.Find(i_strCommand + " ") + 3, strTemp.GetLength());
      // extract the nominal and actual values
      o_intValueNominal = FVal(strTemp.Mid(0, strTemp.Find(" ")));
      o_intValueActual = FVal(strTemp.Mid(strTemp.Find(" "), strTemp.GetLength()));

      if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                          TRACE_LEVEL_RELEASE,
                                          "o_intValueNominal = " + FStr(o_intValueNominal) +
                                          ", o_intValueActual = " + FStr(o_intValueActual),
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
      }
      return(hslTrue);
    } // _GetEnvironmentValues

    //----------------------------------------------------------------------------------------------
    //private function _GetDeviceConfig
    //----------------------------------------------------------------------------------------------
    private function _GetDeviceConfig(variable i_intModuleID, 
                                      variable i_strCallingFunctionName) variable
    {
      variable intIndex(0), intTempStart(4), intCurrentLevel(0), intStorageCapacity(0), intNumberOfStackers(0);
      variable strResponse("");
      string strTemp("");

      i_strCallingFunctionName = i_strCallingFunctionName + ">_GetDeviceConfig";

      if(_Simulated(i_intModuleID, i_strCallingFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      
      // get the number of the maximum storage capacity
      if(!_SendCommand(i_intModuleID, CMD_STORAGE_CAPACITY, "", TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to get maximum storage capacity", strResponse)) return(hslFalse);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pm", ResponseType::INTEGER, intStorageCapacity, i_strCallingFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      gThermoScientific_Cytomat_Interface_arrIntMaxStorageCapacity.SetAt(i_intModuleID, intStorageCapacity);

      // get the number of available levels
      if(!_SendCommand(i_intModuleID, CMD_GET_LEVELS, "", TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to get available level number", strResponse)) return(hslFalse);
      if(!_ProcessResponse(i_intModuleID, strResponse, "sx", ResponseType::STRING, strTemp, i_strCallingFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // extract all levels from the response and store them according to the used ModuleID
      intNumberOfStackers = gThermoScientific_Cytomat_Interface_arrIntAvailableStackers.GetAt(i_intModuleID);
      for(intIndex=0; intIndex < intNumberOfStackers; intIndex++)
      {
        intCurrentLevel = IVal(strTemp.Mid(intTempStart, 3));
        intTempStart = intTempStart + 8;
        if(i_intModuleID == 0) gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.SetAt(intIndex, intCurrentLevel);
        if(i_intModuleID == 1) gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.SetAt(intIndex, intCurrentLevel);
        if(i_intModuleID == 2) gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.SetAt(intIndex, intCurrentLevel);
        if(i_intModuleID == 3) gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.SetAt(intIndex, intCurrentLevel);
      }

      return(hslTrue);
    } // _GetDeviceConfig

    //----------------------------------------------------------------------------------------------
    //private function _GetMaxStackerAndLevel
    //----------------------------------------------------------------------------------------------
    private function _GetMaxStackerAndLevel(variable i_intModuleID,
                                            variable i_intStacker,
                                            variable& o_intMaxStackers,
                                            variable& o_intMaxLevels,
                                            variable i_strCallingFunctionName) variable
    {
      o_intMaxStackers = 42;
      o_intMaxLevels = 22;

      i_strCallingFunctionName = i_strCallingFunctionName + ">_GetMaxStackerAndLevel";

      if(_Simulated(i_intModuleID, i_strCallingFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      o_intMaxStackers = gThermoScientific_Cytomat_Interface_arrIntAvailableStackers.GetAt(i_intModuleID);
      
      if(i_intModuleID == 0)
      { 
        if(gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetSize() < (i_intStacker)) return(hslFalse);
        o_intMaxLevels = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(i_intStacker - 1);
      }
      if(i_intModuleID == 1)
      { 
        if(gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetSize() < (i_intStacker)) return(hslFalse);
        o_intMaxLevels = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(i_intStacker - 1);
      }
      if(i_intModuleID == 2)
      { 
        if(gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetSize() < (i_intStacker)) return(hslFalse);
        o_intMaxLevels = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(i_intStacker - 1);
      }
      if(i_intModuleID == 3)
      { 
        if(gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetSize() < (i_intStacker)) return(hslFalse);
        o_intMaxLevels = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(i_intStacker - 1);
      }
      
      if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                          TRACE_LEVEL_DEBUG,
                                          "o_intMaxStackers = " + IStr(o_intMaxStackers) +
                                          ", o_intMaxLevels = " + IStr(o_intMaxLevels),
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
      }                
     
      return(hslTrue);
    } // _GetMaxStackerAndLevel
    
    //----------------------------------------------------------------------------------------------
    //private function _ProcessResponse
    //----------------------------------------------------------------------------------------------
    private function _ProcessResponse(variable i_intModuleID,
                                      variable i_strOriginalResponse,
                                      variable i_strResponseCommand,
                                      variable i_intProcessedResponseType,
                                      variable& o_varProcessedResponse,
                                      variable i_strCallingFunctionName) variable
    {
      variable strResponse("");
      string strTemp("");

      i_strCallingFunctionName = i_strCallingFunctionName + ">_ProcessResponse";

      if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                            TRACE_LEVEL_DEBUG,
                                            "i_strOriginalResponse = '" + i_strOriginalResponse + "'" +
                                            ", i_strResponseCommand = '" + i_strResponseCommand + "'" +
                                            ", i_intProcessedResponseType = " + IStr(i_intProcessedResponseType),
                                            i_strCallingFunctionName,
                                            gThermoScientific_Cytomat_Interface_intTraceLevel,
                                            gThermoScientific_Cytomat_Interface_strModuleName);
      }

      strTemp = i_strOriginalResponse;
      // check for the correct response
      if(strTemp.Find(i_strResponseCommand + " ") == -1)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          "Incorrect response of: '" + i_strOriginalResponse + "'",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(hslFalse);
      }

      // cut 'dn ' from the response
      strTemp = strTemp.Mid(strTemp.Find(i_strResponseCommand + " ") + 3, strTemp.GetLength());

      if(i_intProcessedResponseType == ResponseType::INTEGER)
      {
        o_varProcessedResponse = IVal(strTemp);
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                          TRACE_LEVEL_DEBUG,
                                          "o_varProcessedResponse = " + IStr(o_varProcessedResponse),
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
      }
      if(i_intProcessedResponseType == ResponseType::FLOAT)
      {
        o_varProcessedResponse = FVal(strTemp);
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                          TRACE_LEVEL_DEBUG,
                                          "o_varProcessedResponse = " + FStr(o_varProcessedResponse),
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
      }
      if(i_intProcessedResponseType == ResponseType::STRING) 
      {
        o_varProcessedResponse = strTemp;
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                          TRACE_LEVEL_DEBUG,
                                          "o_varProcessedResponse = '" + o_varProcessedResponse + "'",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);      
      }

      return(hslTrue);
    } // _ProcessResponse
    
    //----------------------------------------------------------------------------------------------
    //private function _CommandWasSuccessful
    //----------------------------------------------------------------------------------------------
    private function _CommandWasSuccessful(variable i_intModuleID,
                                           variable i_strSentCommand,
                                           variable i_strOriginalResponse,
                                           variable i_strCallingFunctionName) variable
    {
      string strResponse(""), strTrimmedResponse("");

      i_strCallingFunctionName = i_strCallingFunctionName + ">_CommandWasSuccessful";

      if(gThermoScientific_Cytomat_Interface_blnIgnoreResponse)
      {
        gThermoScientific_Cytomat_Interface_blnIgnoreResponse = hslFalse;

        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                          TRACE_LEVEL_DEBUG,
                                          "The following response to command '" + i_strSentCommand + "' was ignored: '" + i_strOriginalResponse + "'",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
      }
      else
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                          TRACE_LEVEL_DEBUG,
                                          "i_strSentCommand = '" + i_strSentCommand + "'" +
                                          ", i_strOriginalResponse = '" + i_strOriginalResponse + "'",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
                                          
        strResponse = i_strOriginalResponse;
        strTrimmedResponse = strResponse.Left(2);
        
        if(strTrimmedResponse.Find("er") != -1)
        {
          Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                            TRACE_LEVEL_RELEASE,
                                            "Error response: '" + _HandleErrorMessage(i_strOriginalResponse) + "'",
                                            i_strCallingFunctionName,
                                            gThermoScientific_Cytomat_Interface_intTraceLevel,
                                            gThermoScientific_Cytomat_Interface_strModuleName);
          return(hslFalse);
        }
      }
      
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        i_strCallingFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      return(hslTrue);
    } // _CommandWasSuccessful

    //----------------------------------------------------------------------------------------------
    //private function _FloatPrecisionFormatter
    //----------------------------------------------------------------------------------------------
    private function _FloatPrecisionFormatter(variable fltValue,
                                              variable intPrecision,
                                              variable i_strCallingFunctionName) variable
    {
        variable intDecimalIndex(0);
        const variable SymbolNotFound(-1);
        string strValue("");

        i_strCallingFunctionName = i_strCallingFunctionName + ">_Initialized";

        strValue = FStr(fltValue);

        intDecimalIndex = strValue.Find(",");
        if(intDecimalIndex == SymbolNotFound)
        {
            intDecimalIndex = strValue.Find(".");
            if(intDecimalIndex == SymbolNotFound)
            {
              Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                                TRACE_LEVEL_RELEASE,
                                                "No valid decimal symbol ('.', ',') was found in the value '" + FStr(fltValue) + "'",
                                                i_strCallingFunctionName,
                                                gThermoScientific_Cytomat_Interface_intTraceLevel,
                                                gThermoScientific_Cytomat_Interface_strModuleName);
            }
        }

        strValue = strValue.Left(intDecimalIndex + 1 + intPrecision);
        return(strValue);
    } // _FloatPrecisionFormatter

    //----------------------------------------------------------------------------------------------
    //private function _DecimalToHex
    //----------------------------------------------------------------------------------------------
    private function _DecimalToHex(variable i_intDecimalValue,
                                   variable i_blnWithPrefix) variable
    {
      variable intIndex(0), intModuloDivisionResult(22);
      variable fltTempDivisionResult(0.0);
      variable strCurrentHexValue(""), strFinalHexValue("");
      variable arrStrHexValues[];

      while (intModuloDivisionResult > 0)
      {
        fltTempDivisionResult = i_intDecimalValue / 16;
        intModuloDivisionResult = i_intDecimalValue % 16;

        i_intDecimalValue = fltTempDivisionResult;

        if      (intModuloDivisionResult == 10) strCurrentHexValue = "A";
        else if (intModuloDivisionResult == 11) strCurrentHexValue = "B";
        else if (intModuloDivisionResult == 12) strCurrentHexValue = "C";
        else if (intModuloDivisionResult == 13) strCurrentHexValue = "D";
        else if (intModuloDivisionResult == 14) strCurrentHexValue = "E";
        else if (intModuloDivisionResult == 15) strCurrentHexValue = "F";
        else strCurrentHexValue = IStr(intModuloDivisionResult);

        arrStrHexValues.AddAsLast(strCurrentHexValue);
      }

      for (intIndex = (arrStrHexValues.GetSize() - 1); intIndex >= 0; intIndex--)
      {
        strFinalHexValue = strFinalHexValue + arrStrHexValues.GetAt(intIndex);
      }
      
      if(i_blnWithPrefix)
      {
        return("0x" + strFinalHexValue);
      }
      else
      {
        return(strFinalHexValue);
      }
    } // _DecimalToHex

    //----------------------------------------------------------------------------------------------
    //private function _DiableTowerShaker
    //----------------------------------------------------------------------------------------------
    private function _DiableTowerShaker(variable i_intModuleID,
                                        variable i_intTowerShaker,
                                        variable i_strCallingFunctionName,
                                        variable& o_blnStackerIsTowerShaker,
                                        variable& o_blnTowerShakerWasShaking,
                                        variable& o_strOriginalTowerShakerSettings) variable
    {
      variable hexTowerShakerBit, hexOptionSettings, hexDisabledTowerShakerSettings;
      variable intDecimalDisabledTowerShakerSettings(0), intTowerShakerRunningStatus(0), intShakingStackerLevel(0);
      variable strResponse(""), strTempResponse("");
      const variable FirstTowerIsShaking(1), SecondTowerIsShaking(2), BothTowersAreShaking(3);
      
      i_strCallingFunctionName = i_strCallingFunctionName + ">_DiableTowerShaker";
      o_blnStackerIsTowerShaker = hslFalse;
      o_blnTowerShakerWasShaking = hslFalse;

      if(!_SendCommand(i_intModuleID, CMD_OPTIONS_REGISTER, "", TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to get info about the ToS ", strResponse)) return(hslFalse);
      if(!_ProcessResponse(i_intModuleID, strResponse, "op", ResponseType::STRING, strTempResponse, i_strCallingFunctionName)) return(hslFalse);

      o_strOriginalTowerShakerSettings = strTempResponse;
      hexOptionSettings = IVal("0x" + o_strOriginalTowerShakerSettings);
      // check if one of the two stackers is set as an active ToS
      if(hexOptionSettings & 0x4000) o_blnStackerIsTowerShaker = hslTrue;
      if(hexOptionSettings & 0x8000) o_blnStackerIsTowerShaker = hslTrue;

      if(o_blnStackerIsTowerShaker)
      {
        // check if Tos are running
        if(!_SendCommand(i_intModuleID, CMD_SHAKER_STATUS, "", TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to get running status of ToS ", strResponse)) return(hslFalse);
        if(!_ProcessResponse(i_intModuleID, strResponse, "as", ResponseType::INTEGER, intTowerShakerRunningStatus, i_strCallingFunctionName)) return(hslFalse);
        // stop the Tos if running
        if(intTowerShakerRunningStatus > 0)
        {
          if(i_intTowerShaker == 1)
          {
            if(intTowerShakerRunningStatus == FirstTowerIsShaking || intTowerShakerRunningStatus == BothTowersAreShaking) o_blnTowerShakerWasShaking = hslTrue;
            intShakingStackerLevel = 1;
            hexTowerShakerBit = 0x4000;
          }
          else
          {
            variable intFirstStackerMax(0), intFirstLevelMax(0);
            if(!_GetMaxStackerAndLevel(i_intModuleID, 1, intFirstStackerMax, intFirstLevelMax, i_strCallingFunctionName)) return(hslFalse);
            if(intTowerShakerRunningStatus == SecondTowerIsShaking || intTowerShakerRunningStatus == BothTowersAreShaking) o_blnTowerShakerWasShaking = hslTrue;
            intShakingStackerLevel = intFirstLevelMax + 1;
            hexTowerShakerBit = 0x8000;
          }

          if(o_blnTowerShakerWasShaking)
          {
            if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", i_strCallingFunctionName)) return(hslFalse);
            if(!_SendCommand(i_intModuleID, LL_SHAKER_STOP, IStr(intShakingStackerLevel), TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to stop ToS ", strResponse)) return(hslFalse);
          }
        }
        // trace the original option settings value. May be needed in case of an unexpected error to reset the settings
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::PROGRESS,
                                          TRACE_LEVEL_RELEASE,
                                          "Option Settings register Hex value: '" + o_strOriginalTowerShakerSettings + "'",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        // set ToS to inactive
        intDecimalDisabledTowerShakerSettings = hexOptionSettings - hexTowerShakerBit;
        hexDisabledTowerShakerSettings = _DecimalToHex(intDecimalDisabledTowerShakerSettings, hslFalse);
        if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", i_strCallingFunctionName)) return(hslFalse);
        if(!_SendCommand(i_intModuleID, SB_OPTIONS_REGISTER, hexDisabledTowerShakerSettings, TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to diable ToS ", strResponse)) return(hslFalse);
      }
      return(hslTrue);
    } // _DiableTowerShaker

    //----------------------------------------------------------------------------------------------
    //private function _EnableTowerShaker
    //----------------------------------------------------------------------------------------------
    private function _EnableTowerShaker(variable i_intModuleID,
                                        variable i_intTowerShaker,
                                        variable i_blnTowerShakerWasShaking,
                                        variable i_strOriginalTowerShakerSettings,
                                        variable i_strCallingFunctionName) variable
    {
      variable hexTowerShakerBit, hexOptionSettings, hexEnabledTowerShakerSettings;
      variable intShakingStackerLevel(0), intDecimalEnabledTowerShakerSettings(0);
      variable strResponse("");

      i_strCallingFunctionName = i_strCallingFunctionName + ">_EnableTowerShaker";
      // set ToS to active
      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", i_strCallingFunctionName)) return(hslFalse);
      if(!_SendCommand(i_intModuleID, SB_OPTIONS_REGISTER, i_strOriginalTowerShakerSettings, TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to enable ToS ", strResponse)) return(hslFalse);
      
      if(i_blnTowerShakerWasShaking)
      {
        if(i_intTowerShaker == 1)
        {
          intShakingStackerLevel = 1;
        }
        else
        {
          variable intFirstStackerMax(0), intFirstLevelMax(0);
          if(!_GetMaxStackerAndLevel(i_intModuleID, 1, intFirstStackerMax, intFirstLevelMax, i_strCallingFunctionName)) return(hslFalse);
          intShakingStackerLevel = intFirstLevelMax + 1;
        }
        if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", i_strCallingFunctionName)) return(hslFalse);
        if(!_SendCommand(i_intModuleID, LL_SHAKER_START, IStr(intShakingStackerLevel), TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to stop ToS ", strResponse)) return(hslFalse);
      }
      return(hslTrue);
    } // _EnableTowerShaker

    //----------------------------------------------------------------------------------------------
    //private function _Initialized
    //----------------------------------------------------------------------------------------------
    private function _Initialized(variable i_intModuleID, 
                                  variable i_strCallingFunctionName) variable
    {
      i_strCallingFunctionName = i_strCallingFunctionName + ">_Initialized";

      if(gThermoScientific_Cytomat_Interface_arrBlnInitialized.GetAt(i_intModuleID)) return(hslTrue);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                        TRACE_LEVEL_RELEASE,
                                        "Device with ID " + IStr(i_intModuleID) + " not initialized!",
                                        i_strCallingFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(hslFalse);
    } // _Initialized

    //----------------------------------------------------------------------------------------------
    //private function _Simulated
    //----------------------------------------------------------------------------------------------
    private function _Simulated(variable i_intModuleID,
                                variable i_strCallingFunctionName) variable
    {
      i_strCallingFunctionName = i_strCallingFunctionName + ">_Simulated";

      if(!gThermoScientific_Cytomat_Interface_arrBlnSimulated.GetAt(i_intModuleID)) return(hslFalse);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "Device " + IStr(i_intModuleID) + " is simulated",
                                        i_strCallingFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(hslTrue);
    } // _Simulated

    //----------------------------------------------------------------------------------------------
    //private function _DeviceSupported
    //----------------------------------------------------------------------------------------------
    private function _DeviceSupported(variable i_intModuleID,
                                      variable i_arrIntAllowedValues[],
                                      variable i_strCallingFunctionName) variable
    {
      variable intCurrentDevice(0), intActualArrayPosition(0), intActualValue(0);
      i_strCallingFunctionName = i_strCallingFunctionName + ">_DeviceSupported";
  
      intCurrentDevice = gThermoScientific_Cytomat_Interface_arrIntAvailableDevices.GetAt(i_intModuleID);

      for(intActualArrayPosition = 0; intActualArrayPosition < i_arrIntAllowedValues.GetSize(); intActualArrayPosition++)
      {
        intActualValue = i_arrIntAllowedValues.GetAt(intActualArrayPosition);
        if(intCurrentDevice == intActualValue) return(hslTrue);
      }
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                        TRACE_LEVEL_RELEASE,
                                        "This function is not supported for the type: '" + gThermoScientific_Cytomat_Interface_arrStrCytomatTypes.GetAt(i_intModuleID) + "'",
                                        i_strCallingFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(hslFalse);
    } // _DeviceSupported

    // --------------------------------------------------------------------------------------
    // function _GetInventoryManagementCharacters
    // --------------------------------------------------------------------------------------
    private function _GetInventoryManagementCharacters(variable i_intModuleID,
                                                       variable i_strCallingFunctionName) variable
    {
      variable strResponse(""), strProcessedResponse(""), strManagementCharacters(""), strTemp(""), strCutResponse("");
      variable intIndex(0), intFoundIndex(0);
      string strTempResponse("");
      
      i_strCallingFunctionName = i_strCallingFunctionName + ">_GetInventoryManagementCharacters";
      
      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", i_strCallingFunctionName)) return(hslFalse);
      if(!_SendCommand(i_intModuleID, CMD_GETINVENTORY_CHARACTERS, "", TIMEOUT_SHORT, "", i_strCallingFunctionName, "Unable to get character management settings", strResponse)) return(hslFalse);
      if(!_ProcessResponse(i_intModuleID, strResponse, "cb", ResponseType::STRING, strProcessedResponse, i_strCallingFunctionName)) return(hslFalse);
      strTempResponse = strProcessedResponse;
      // split each management character of form '-;?;1;0' and only save the character without the ';' in an array
      for(intIndex = 0; intIndex < 4; intIndex++)
      {
        intFoundIndex = strTempResponse.Find(";");
        if((intFoundIndex == -1) && (intIndex == 3)) // this case is needed to extract the last value (contains no ';')
        {
          strTemp = strTempResponse;
          gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters.SetAt(intIndex, strTemp);
        } else  // extract every inventory management character bewteen ';'
          {
            strTemp = strTempResponse.Mid(0, intFoundIndex);
            gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters.SetAt(intIndex, strTemp);
            strCutResponse = strTempResponse.Right(strTempResponse.GetLength() - (intFoundIndex + 1));
            strTempResponse = strCutResponse;
          }
      }
      return(hslTrue);
    } // _GetInventoryManagementCharacters

    //----------------------------------------------------------------------------------------------
    //private function _GetPlateDetectionMethod
    //----------------------------------------------------------------------------------------------
    private function _GetPlateDetectionMethod(variable i_intModuleID,
                                              variable i_strCallingFunctionName) variable
    {
      variable strResponse(""), strProcessedResponse("");
      variable blnHasP3Sensor(hslFalse), blnHasBarcodeReader(hslFalse);
      variable intStatusByte(0);

      i_strCallingFunctionName = i_strCallingFunctionName + ">_GetPlateDetectionMethod";
      
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        i_strCallingFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      
      if(!_SendCommand(i_intModuleID, CMD_OPTIONS_REGISTER, "", TIMEOUT_LONG, "", i_strCallingFunctionName, "Unable to query option settings register", strResponse)) return(hslFalse);
      if(!_ProcessResponse(i_intModuleID, strResponse, "op", ResponseType::STRING, strProcessedResponse, i_strCallingFunctionName)) return(hslFalse);
      intStatusByte = IVal("0x" + strProcessedResponse);

      if(intStatusByte & 0x004) blnHasP3Sensor = hslTrue; else blnHasP3Sensor = hslFalse;
      if(intStatusByte & 0x100) blnHasBarcodeReader = hslTrue; else blnHasBarcodeReader = hslFalse;

      gThermoScientific_Cytomat_Interface_arrblnHasP3Sensor.SetAt(i_intModuleID, blnHasP3Sensor);
      gThermoScientific_Cytomat_Interface_arrblnHasBarcodeReader.SetAt(i_intModuleID, blnHasBarcodeReader);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "P3 Sensor: '" + IStr(blnHasP3Sensor) + "'" +
                                        ", Barcode Reader: '" + IStr(blnHasBarcodeReader) + "'",
                                        i_strCallingFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      return(hslTrue);
    } // _GetPlateDetectionMethod

    //----------------------------------------------------------------------------------------------
    //private function _DeviceSupportsInventoryManagement
    //----------------------------------------------------------------------------------------------
    private function _DeviceSupportsInventoryManagement(variable i_intModuleID,
                                                        variable i_strCallingFunctionName) variable
    {
      
      i_strCallingFunctionName = i_strCallingFunctionName + ">_GetPlateDetectionMethod";

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        i_strCallingFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(gThermoScientific_Cytomat_Interface_arrblnHasP3Sensor.GetAt(i_intModuleID) || gThermoScientific_Cytomat_Interface_arrblnHasBarcodeReader.GetAt(i_intModuleID))
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                          TRACE_LEVEL_DEBUG,
                                          "",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(hslTrue);
      }
      else
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          "Device does not support inventory management!",
                                          i_strCallingFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(hslFalse);
      }
    } // _DeviceSupportsInventoryManagement

    //----------------------------------------------------------------------------------------------
    //private function _InitializeArrays
    //----------------------------------------------------------------------------------------------
    private function _InitializeArrays() void
    {
      // devices that support tower shaking functions
      gThermoScientific_Cytomat_Interface_arrIntCanShake.AddAsLast(CytomatType::C2_LINEAR);
      
      // devices that support agitation funcitons
      gThermoScientific_Cytomat_Interface_arrIntCanAgitate.AddAsLast(CytomatType::C5);
      gThermoScientific_Cytomat_Interface_arrIntCanAgitate.AddAsLast(CytomatType::C10);
    } // _InitializeArrays

    //----------------------------------------------------------------------------------------------
    //private function _HandlerErrorMessage
    //----------------------------------------------------------------------------------------------
    function _HandleErrorMessage(variable strErrorMessage) variable
    {
      variable intErrorMessage(0);
      string strConvertedErrorMessage("");
      variable i_intModuleID(0); // i_intModuleID is not needed to retrieve the erro message hence it is set to 0
      variable strCallingFunctionName("_HandlerErrorMessage");
      variable strProcessedResponse("");

      strConvertedErrorMessage = strErrorMessage;

      if(strConvertedErrorMessage.Find("be") != -1)
      {
        if(!_ProcessResponse(i_intModuleID, strErrorMessage, "be", ResponseType::STRING, strProcessedResponse, strCallingFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
        intErrorMessage = IVal("0x" + strProcessedResponse);

        if(intErrorMessage == 0x00) return("No error");
        //if(intErrorMessage == 0x01) return("-Not used-");
        if(intErrorMessage == 0x02) return("MP not loaded on handler");
        if(intErrorMessage == 0x03) return("MP not unloaded from handler");
        if(intErrorMessage == 0x04) return("Shovel not extended");
        if(intErrorMessage == 0x05) return("Process timeout");
        if(intErrorMessage == 0x06) return("Gate not opened");
        if(intErrorMessage == 0x07) return("Gate not closed");
        if(intErrorMessage == 0x08) return("Shovel not retracted");
        //if(intErrorMessage == 0x09) return("-Not used-");
        if(intErrorMessage == 0x10) return("Orientation Z-axis turn not in the direction to transfer station");
        if(intErrorMessage == 0x11) return("Orientation Z-axis turn not in the direction to stacker");
        if(intErrorMessage == 0x12) return("Turntable not in position over sensor");
        if(intErrorMessage == 0x13) return("No MP on Storage position");
        if(intErrorMessage == 0x14) return("MP unexpectedly on storage position");
        //if(intErrorMessage == 0x15) return("-Not used-");
        //if(intErrorMessage == 0x16) return("-Not used-");
        //if(intErrorMessage == 0x17) return("-Not used-");
        //if(intErrorMessage == 0x18) return("-Not used-");
        //if(intErrorMessage == 0x19) return("-Not used-");
        //if(intErrorMessage == 0x20) return("-Not used-");
        //if(intErrorMessage == 0x21) return("-Not used-");
        if(intErrorMessage == 0x22) return("Power stage error - Motor controller address 0 - Turntable or X-axis");
        if(intErrorMessage == 0x23) return("Power stage error - Motor controller address 0 - Shovel");
        if(intErrorMessage == 0x24) return("Power stage under voltage - Motor controller address 0 - Turntable or X-axis");
        if(intErrorMessage == 0x25) return("Power stage under voltage - Motor controller address 0 - Shovel");
        if(intErrorMessage == 0x26) return("Power stage overtemperature - Motor controller address 0 - Turntable or X-axis");
        if(intErrorMessage == 0x27) return("Power stage overtemperature - Motor controller address 0 - Shovel");
        //if(intErrorMessage == 0x28) return("-Not used-");
        //if(intErrorMessage == 0x29) return("-Not used-");
        //if(intErrorMessage == 0x30) return("-Not used-");
        //if(intErrorMessage == 0x31) return("-Not used-");
        if(intErrorMessage == 0x32) return("Power stage error - Motor controller address 1 - Z-axis height");
        if(intErrorMessage == 0x33) return("Power stage error - Motor controller address 1 - Z-axis turn");
        if(intErrorMessage == 0x34) return("Power stage under voltage - Motor controller address 1 - Z-axis height");
        if(intErrorMessage == 0x35) return("Power stage under voltage - Motor controller address 1 - Z-axis turn");
        if(intErrorMessage == 0x36) return("Power stage overtemperature - Motor controller address 1 - Z-axis height");
        if(intErrorMessage == 0x37) return("Power stage overtemperature - Motor controller address 1 - Z-axis turn");
        //if(intErrorMessage == 0x38) return("-Not used-");
        //if(intErrorMessage == 0x39) return("-Not used-");
        //if(intErrorMessage == 0x40) return("-Not used-");
        //if(intErrorMessage == 0x41) return("-Not used-");
        if(intErrorMessage == 0x42) return("Power stage error - Motor controller address 2 - SMD TS 1");
        if(intErrorMessage == 0x43) return("Power stage error - Motor controller address 2 - SMD TS 2");
        if(intErrorMessage == 0x44) return("Power stage under voltage - Motor controller address 2 - SMD TS 1");
        if(intErrorMessage == 0x45) return("Power stage under voltage - Motor controller address 2 - SMD TS 2");
        if(intErrorMessage == 0x46) return("Power stage overtemperature - Motor controller address 2 - SMD TS 1");
        if(intErrorMessage == 0x47) return("Power stage overtemperature - Motor controller address 2 - SMD TS 2");
        //if(intErrorMessage == 0x48) return("-Not used-");
        //if(intErrorMessage == 0x49) return("-Not used-");
        if(intErrorMessage == 0x50) return("Error during start of the Agitation");
        //if(intErrorMessage == 0x51) return("-Not used-");
        if(intErrorMessage == 0x52) return("Error during start up - Loading inventory");
        if(intErrorMessage == 0x53) return("Error during start up - Loading inventory character settings");
        if(intErrorMessage == 0x54) return("Error during start up - Loading device name");
        if(intErrorMessage == 0x55) return("Error during start up - Loading equipment no./serial no.");
        if(intErrorMessage == 0x56) return("Error during start up - Loading service status");
        if(intErrorMessage == 0x57) return("Error during start up - Loading parameters");
        if(intErrorMessage == 0x58) return("Error during start up - First refresh of RTC");
        if(intErrorMessage == 0x59) return("Error during start up - Set up of barcode reader");
        if(intErrorMessage == 0x60) return("ToS - Communication is disturbed");
        if(intErrorMessage == 0x61) return("ToS - Configuration is invalid");
        if(intErrorMessage == 0x62) return("ToS - Not started");
        if(intErrorMessage == 0x63) return("ToS - Not stopped");
        if(intErrorMessage == 0x64) return("ToS - Clamp not opened");
        if(intErrorMessage == 0x65) return("ToS - Clamp not closed");
        // if none of the above cases apply
        return("Error '" + strErrorMessage + "' is not used according to the manual");
      }
      if(strConvertedErrorMessage.Find("er") != -1)
      {
        if(!_ProcessResponse(i_intModuleID, strErrorMessage, "er", ResponseType::STRING, strProcessedResponse, strCallingFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
        intErrorMessage = IVal("0x" + strProcessedResponse);

        if(intErrorMessage == 0x00) return("No error");
        if(intErrorMessage == 0x01) return("Device still busy, new command is not accepted");
        if(intErrorMessage == 0x02) return("Unknown command");
        if(intErrorMessage == 0x03) return("Telegram structure error");
        if(intErrorMessage == 0x04) return("Incorrect parameter in the telegram");
        if(intErrorMessage == 0x05) return("Unknown storage position specified");
        if(intErrorMessage == 0x06) return("Unknown stacker number specified");
        if(intErrorMessage == 0x07) return("Unknown level in stacker");
        if(intErrorMessage == 0x08) return("No Plate detection - On transfer station configured");
        if(intErrorMessage == 0x09) return("ContraCon active, new command is not accepted");
        if(intErrorMessage == 0x10) return("Unable to perform command");
        if(intErrorMessage == 0x11) return("Incorrect start position");
        if(intErrorMessage == 0x12) return("Unable to perform command, shovel extended");
        if(intErrorMessage == 0x13) return("No Barcode reader available - Barcode reader is managed externally");
        if(intErrorMessage == 0x14) return("No Plate detection - In stacker (P³-Sensor) configured");
        if(intErrorMessage == 0x15) return("No Barcode reader configured");
        if(intErrorMessage == 0x16) return("No Barcode reader available and no Plate detection - In stacker (P³-Sensor) configured");
        if(intErrorMessage == 0x17) return("No Buzzer configured");
        if(intErrorMessage == 0x18) return("Unable to perform command - No free storage position");
        if(intErrorMessage == 0x19) return("Labware ID always at specified storage position");
        if(intErrorMessage == 0x20) return("Unknown labware ID specified");
        if(intErrorMessage == 0x21) return("Handler is already occupied");
        if(intErrorMessage == 0x22) return("Handler is empty");
        if(intErrorMessage == 0x23) return("Wait position disabled");
        if(intErrorMessage == 0x24) return("Unable to perform command - Not available for Cytomat 2-LiN");
        //if(intErrorMessage == 0x25) return("- Not used -");
        if(intErrorMessage == 0x26) return("Unable to perform command - ContraCon motion disabled");
        if(intErrorMessage == 0x27) return("Unable to perform command - Not available for this barcode reader type");
        if(intErrorMessage == 0x28) return("Stacker position is occupied");
        if(intErrorMessage == 0x29) return("Stacker position is empty");
        if(intErrorMessage == 0x30) return("No transfer station configured");
        if(intErrorMessage == 0x31) return("Transfer station is empty");
        if(intErrorMessage == 0x32) return("Transfer station is occupied");
        if(intErrorMessage == 0x33) return("Transfer station not in position");
        if(intErrorMessage == 0x34) return("Transfer station already in position");
        if(intErrorMessage == 0x35) return("No turnable transfer station configured");
        if(intErrorMessage == 0x36) return("No 180° turnable transfer station (Swap station) configured");
        if(intErrorMessage == 0x37) return("No DC transfer station configured");
        if(intErrorMessage == 0x38) return("No SMD transfer station configured");
        if(intErrorMessage == 0x39) return("Inventory not valid");
        if(intErrorMessage == 0x40) return("Door opened, new command is not accepted");
        if(intErrorMessage == 0x41) return("No gate configured");
        if(intErrorMessage == 0x42) return("Gate not opened");
        if(intErrorMessage == 0x43) return("No Barcode reader and no Plate detection - In stacker (P³ sensor) configured");
        if(intErrorMessage == 0x44) return("Gate already in position");
        if(intErrorMessage == 0x45) return("No ContraCon motion active");
        if(intErrorMessage == 0x46) return("No inventory check / location scan active");
        if(intErrorMessage == 0x47) return("PSS board not time/date MASTER");
        if(intErrorMessage == 0x48) return("Password not correct");
        if(intErrorMessage == 0x49) return("Password not set");
        if(intErrorMessage == 0x50) return("Error accessing the Stepper motor controller while reading parameter");
        if(intErrorMessage == 0x51) return("Error accessing the Stepper motor controller while storing parameter");
        if(intErrorMessage == 0x52) return("Error accessing the Stepper motor controller while getting status");
        if(intErrorMessage == 0x53) return("Error accessing the internal memory (EEPROM)");
        if(intErrorMessage == 0x54) return("Error accessing the internal RTC");
        if(intErrorMessage == 0x55) return("Error accessing incubator parameter");
        if(intErrorMessage == 0x56) return("No Incubator present");
        if(intErrorMessage == 0x57) return("Error while resetting the stepper motor controller");
        if(intErrorMessage == 0x58) return("Unable to perform command - Parameters for Agitation not set");
        if(intErrorMessage == 0x59) return("Unable to perform command - No Agitation active");
        if(intErrorMessage == 0x60) return("Unable to perform command - Agitation option not configured");
        if(intErrorMessage == 0x61) return("Unable to perform command - No Tower Shaker active");
        if(intErrorMessage == 0x62) return("Unable to perform command - Agitation active");
        if(intErrorMessage == 0x63) return("Unable to perform command - Tower Shaker option not configured");
        if(intErrorMessage == 0x64) return("Unable to perform command - Tower Shaker not initialized");
        if(intErrorMessage == 0x65) return("Unable to perform command - (Already) No shaking of Tower Shaker 1 active");
        if(intErrorMessage == 0x66) return("Unable to perform command - Shaking of Tower Shaker 1 (already) active");
        if(intErrorMessage == 0x67) return("Unable to perform command - (Already) No shaking of Tower Shaker 2 active");
        if(intErrorMessage == 0x68) return("Unable to perform command - Shaking of Tower Shaker 2 (already) active");
        if(intErrorMessage == 0x69) return("Unable to perform command - (Already) No shaking of Tower Shaker active");
        if(intErrorMessage == 0x70) return("Unable to perform command - Shaking of Tower Shaker (already) active");
        if(intErrorMessage == 0x71) return("Unable to perform command - Tower Shaker 1 not active");
        if(intErrorMessage == 0x72) return("Unable to perform command - Tower Shaker 2 not active");
        //if(intErrorMessage == 0x73) return("- Not used -");
        //if(intErrorMessage == 0x74) return("- Not used -");
        if(intErrorMessage == 0x75) return("Unable to perform command - Not available for Cytomat 5/10");
        //if(intErrorMessage == 0x76) return("- Not used -");
        //if(intErrorMessage == 0x77) return("- Not used -");
        //if(intErrorMessage == 0x78) return("- Not used -");
        //if(intErrorMessage == 0x79) return("- Not used -");
        //if(intErrorMessage == 0x80) return("- Not used -");
        //if(intErrorMessage == 0x81) return("- Not used -");
        //if(intErrorMessage == 0x82) return("- Not used -");
        //if(intErrorMessage == 0x83) return("- Not used -");
        //if(intErrorMessage == 0x84) return("- Not used -");
        //if(intErrorMessage == 0x85) return("- Not used -");
        //if(intErrorMessage == 0x86) return("- Not used -");
        if(intErrorMessage == 0x87) return("No <CR> (carriage return) after command (e.g. mv:st?001)");
        if(intErrorMessage == 0x88) return("No <SP> (space) between command and first parameter (e.g. mv:st001<CR>)");
        if(intErrorMessage == 0x89) return("Error while getting parameters from telegram");
        //if(intErrorMessage == 0x90) return("- Not used -");
        //if(intErrorMessage == 0x91) return("- Not used -");
        //if(intErrorMessage == 0x92) return("- Not used -");
        //if(intErrorMessage == 0x93) return("- Not used -");
        //if(intErrorMessage == 0x94) return("- Not used -");
        //if(intErrorMessage == 0x95) return("- Not used -");
        //if(intErrorMessage == 0x96) return("- Not used -");
        //if(intErrorMessage == 0x97) return("- Not used -");
        //if(intErrorMessage == 0x98) return("- Not used -");
        if(intErrorMessage == 0x99) return("No error - Syntax check mode");
        // if none of the above cases apply
        return("Error '" + strErrorMessage + "' is not used according to the manual");
      }
      if(strConvertedErrorMessage.Find("be") == -1 && strConvertedErrorMessage.Find("er") == -1)
      {
        return("Response was not of an error message!");
      }
    } // _HandlerErrorMessage

  } // end namespace
