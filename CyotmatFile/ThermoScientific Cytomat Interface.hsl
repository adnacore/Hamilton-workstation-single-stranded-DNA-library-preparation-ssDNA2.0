      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanShake, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // if i_intStoragePosition is set to 0 all available ToS stop shaking
      if(i_intStoragePosition == 0)
      {
        if(!_SendCommand(i_intModuleID, LL_SHAKER_STOP, "", TIMEOUT_LONG, "", strFunctionName, "Unable to stop tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      }
      else
