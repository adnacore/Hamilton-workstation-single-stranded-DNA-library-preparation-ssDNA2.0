   //----------------------------------------------------------------------------------------------
   //function Initialize
   //----------------------------------------------------------------------------------------------
    function Initialize(variable i_intCOMPort,
                        variable i_intCytomatType,
                        variable i_blnSimulationMode,
                        variable& o_intModuleID) variable
    {
      variable strFunctionName("Initialize"), strResponse(""), currentDate(""), currentTime(""), currentDateTime("");
      variable intStacker(0), intIndex(0);
      variable arrIntAllowedCytomatTypes[](0);

      arrIntAllowedCytomatTypes.AddAsLast(CytomatType::C2_LINEAR);
      arrIntAllowedCytomatTypes.AddAsLast(CytomatType::C5);
      arrIntAllowedCytomatTypes.AddAsLast(CytomatType::C10);
      arrIntAllowedCytomatTypes.AddAsLast(CytomatType::C24);

      // initialize arrays with supported devices
      _InitializeArrays();

      if(Hamilton_DriverTools::CheckIntegerRange(i_intCOMPort,
                                                 "i_intCOMPort",
                                                 1,
                                                 256,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckValueInArray(i_intCytomatType,
                                                 "i_intCytomatType",
                                                 Hamilton_DriverTools::DATA_TYPE::INTEGER,
                                                 arrIntAllowedCytomatTypes,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckBool(i_blnSimulationMode,
                                         "i_blnSimulationMode",
                                         strFunctionName,
                                         gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(gThermoScientific_Cytomat_Interface_intTraceLevel == 0) gThermoScientific_Cytomat_Interface_intTraceLevel = TRACELEVEL::GetTraceLevel();

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intCOMPort = " + IStr(i_intCOMPort) +
                                        ", i_intCytomatType = " + IStr(i_intCytomatType) +
                                        ", i_blnSimulationMode = " + IStr(i_blnSimulationMode),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!gThermoScientific_Cytomat_Interface_blnLibraryInitialized)
      {
        variable intActualDevice(0);

        for(intActualDevice = 0; intActualDevice < MAX_DEVICES; intActualDevice++)
        {
          gThermoScientific_Cytomat_Interface_arrIntCOMPorts.SetAt(intActualDevice, "- free -");
          gThermoScientific_Cytomat_Interface_arrStrCytomatTypes.SetAt(intActualDevice, "Unknown");
          gThermoScientific_Cytomat_Interface_arrBlnInitialized.SetAt(intActualDevice, hslFalse);
          gThermoScientific_Cytomat_Interface_arrBlnSimulated.SetAt(intActualDevice, hslFalse);
        }
        if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
        {
          Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                            TRACE_LEVEL_DEBUG,
                                            "Initialized library",
                                            strFunctionName,
                                            gThermoScientific_Cytomat_Interface_intTraceLevel,
                                            gThermoScientific_Cytomat_Interface_strModuleName);
        }
        gThermoScientific_Cytomat_Interface_blnLibraryInitialized = hslTrue;
      }

      if(_InitializeDevice(i_intCOMPort,
                           i_intCytomatType,
                           i_blnSimulationMode,
                           strFunctionName,
                           o_intModuleID) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(o_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      // send dummy command to ignore er02 on some serial cards
      gThermoScientific_Cytomat_Interface_blnIgnoreResponse = hslTrue;
      if(!_SendCommand(o_intModuleID, CMD_ERROR_STATUS, "", TIMEOUT_SHORT, "", strFunctionName, "Unable to send dummy command", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      // reset error bit. Otherwise _WaitForReady will fail.
      if(!_SendCommand(o_intModuleID, RS_RESET_ERROR, "", TIMEOUT_SHORT, "", strFunctionName, "Unable to reset error bit", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_WaitForReady(o_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      currentDate = GetDate("%d.%m.%y");
      currentTime = GetTime("%H:%M:%S");
      currentDateTime = currentDate + " " + currentTime;
      // setting the Cytomats time can only be done with newer models. Therefore the response is ignored if it fails.
      gThermoScientific_Cytomat_Interface_blnIgnoreResponse = hslTrue;
      if(!_SendCommand(o_intModuleID, SE_DATE_TIME, currentDateTime, TIMEOUT_SHORT, "", strFunctionName, "Unable to set current date and time", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_SendCommand(o_intModuleID, LL_INITIALIZE, "", TIMEOUT_SHORT, "", strFunctionName, "Unable to initialize", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_GetPlateDetectionMethod(o_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      // get the number of available stackers
      if(!_SendCommand(o_intModuleID, CMD_GET_STACKER, "", TIMEOUT_SHORT, "", strFunctionName, "Unable to get available stacker number", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(o_intModuleID, strResponse, "sn", ResponseType::INTEGER, intStacker, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      gThermoScientific_Cytomat_Interface_arrIntAvailableStackers.SetAt(o_intModuleID, intStacker);
      // initialize the array with the size of available stackers
      for(intIndex=0; intIndex < intStacker; intIndex++)
      {
        if(o_intModuleID == 0) gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.AddAsLast(0);
        if(o_intModuleID == 1) gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.AddAsLast(0);
        if(o_intModuleID == 2) gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.AddAsLast(0);
        if(o_intModuleID == 3) gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.AddAsLast(0);
      }

      if(!_GetDeviceConfig(o_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_WaitForReady(o_intModuleID, TIMEOUT_MEDIUM, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "o_intModuleID = " + IStr(o_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      return(ASWGLOBAL::BOOL::TRUE);
    } // Initialize

    //----------------------------------------------------------------------------------------------
    // function SetTraceLevel
    //----------------------------------------------------------------------------------------------
    function SetTraceLevel(variable i_intModuleID,
                           variable i_intTraceLevel) variable
    {
      variable strFunctionName("SetTraceLevel");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intTraceLevel,
                                                 "i_intTraceLevel",
                                                 TRACE_LEVEL_RELEASE,
                                                 TRACE_LEVEL_DEBUG,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intTraceLevel = " + IStr(i_intTraceLevel),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      gThermoScientific_Cytomat_Interface_intTraceLevel = i_intTraceLevel;

      if(gThermoScientific_Cytomat_Interface_blnLibraryInitialized)
      {
        Hamilton_SerialInterface::SetTraceLevelSilent(i_intModuleID, i_intTraceLevel);
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // SetTraceLevel

    // --------------------------------------------------------------------------------------
    // function SetExtendedTrace
    // --------------------------------------------------------------------------------------
    function SetExtendedTrace(variable i_intModuleID,
                              variable i_blnExtendedTrace) variable
    {
      variable strFunctionName("SetExtendedTrace");

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(i_blnExtendedTrace == hslTrue) gThermoScientific_Cytomat_Interface_blnExtendedTrace = hslTrue;

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // SetExtendedTrace

    //----------------------------------------------------------------------------------------------
    //function Terminate
    //----------------------------------------------------------------------------------------------
    function Terminate(variable i_intModuleID) variable
    {
      variable strFunctionName("Terminate");
      variable intIndex(0);
      
      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_TerminateDevice(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(gThermoScientific_Cytomat_Interface_intTraceLevel == TRACE_LEVEL_DEBUG) Hamilton_SerialInterface::ShowUsage();
      
      gThermoScientific_Cytomat_Interface_arrIntCOMPorts.SetAt(i_intModuleID, "- free -");
      gThermoScientific_Cytomat_Interface_arrBlnSimulated.SetAt(i_intModuleID, hslFalse);
      gThermoScientific_Cytomat_Interface_arrIntAvailableDevices.SetAt(i_intModuleID, 0);
      gThermoScientific_Cytomat_Interface_arrStrCytomatTypes.SetAt(i_intModuleID, "Unknown");
      gThermoScientific_Cytomat_Interface_arrBlnInitialized.SetAt(i_intModuleID, hslFalse);
      gThermoScientific_Cytomat_Interface_arrIntAvailableStackers.SetAt(i_intModuleID, 0);
      if(i_intModuleID == 0) 
      {
        for(intIndex = 0; intIndex < gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetSize(); intIndex++)
          gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.SetAt(intIndex, 0);
      }
      if(i_intModuleID == 1) 
      {
        for(intIndex = 0; intIndex < gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetSize(); intIndex++)
          gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.SetAt(intIndex, 0);
      }
      if(i_intModuleID == 2) 
      {
        for(intIndex = 0; intIndex < gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetSize(); intIndex++)
          gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.SetAt(intIndex, 0);
      }
      if(i_intModuleID == 3) 
      {
        for(intIndex = 0; intIndex < gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetSize(); intIndex++)
          gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.SetAt(intIndex, 0);
      }
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      return(ASWGLOBAL::BOOL::TRUE);
    } // Terminate

    // --------------------------------------------------------------------------------------
    // function GetLabwareIDs
    // --------------------------------------------------------------------------------------
    function GetLabwareIDs(variable i_intModuleID,
                           variable i_intStacker,
                           variable i_blnWaitForFinish,
                           variable& o_arrStrLabwareIDs[]) variable
    {
      const variable NoSemicolonFound(-1);
      variable strFunctionName("GetLabwareIDs");
      variable strResponse(""), strParameter("");
      variable strStacker(""), strLevel("");
      string strTempResponse(""), strCutResponse(""), strTempLabware(""), strTrimmedLabwareID("");
      variable intStackerMax(0), intLevelMax(0), intIndex(0), intSemicolonPosition(0);
      
      // Get the max stacker and level capacity for the current used device
      if(!_GetMaxStackerAndLevel(i_intModuleID, i_intStacker, intStackerMax, intLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStacker,
                                                 "i_intStacker",
                                                 1,
                                                 intStackerMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckBool(i_blnWaitForFinish,
                                         "i_blnWaitForFinish",
                                         strFunctionName,
                                         gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intStacker = " + IStr(i_intStacker) +
                                        ", i_blnWaitForFinish = " + IStr(i_blnWaitForFinish),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      o_arrStrLabwareIDs.SetSize(0);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      o_arrStrLabwareIDs.AddAsLast("- Simulated Labware ID 1 - ");
      o_arrStrLabwareIDs.AddAsLast("- Simulated Labware ID 2 - ");

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      o_arrStrLabwareIDs.SetSize(0);

      if(!_DeviceSupportsInventoryManagement(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetInventoryManagementCharacters(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      strStacker = IStr(i_intStacker);
      if(!_SendCommand(i_intModuleID, CMD_GETLABWARE_ID, strStacker, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to get labware IDs ", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "bx", ResponseType::STRING, strTempResponse, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                          TRACE_LEVEL_DEBUG,
                                          "Retrieved Labware IDs: " + strResponse,
                                          strFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
      }
      // extract every single labware ID that is returned in form of <labware_ID_1;labware_ID_2;labware_ID_3, ...>
      for(intIndex = 1; intIndex < intLevelMax + 1; intIndex++)
      {
        intSemicolonPosition = strTempResponse.Find(";");
        if(intIndex == intLevelMax && intSemicolonPosition == NoSemicolonFound) // case for the last value
        {
          strTempLabware = strTempResponse.Mid(0, strTempResponse.GetLength());
        }
        else
        {
          strTempLabware = strTempResponse.Mid(0, intSemicolonPosition);
          strTempResponse = strTempResponse.Mid(intSemicolonPosition + 1, strTempResponse.GetLength() - intSemicolonPosition); 
        }
        strTrimmedLabwareID = Hamilton_DriverTools::TrimRight(strTempLabware, " ", strFunctionName, gThermoScientific_Cytomat_Interface_strModuleName);
        o_arrStrLabwareIDs.AddAsLast(strTrimmedLabwareID);
      }

      if(i_blnWaitForFinish == ASWGLOBAL::BOOL::TRUE)
      {
        if(!_WaitForReady(i_intModuleID, TIMEOUT_LONG, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      }

      Hamilton_DriverTools::StatusAddArray("o_arrStrLabwareIDs", o_arrStrLabwareIDs, gThermoScientific_Cytomat_Interface_strModuleName);

      Hamilton_DriverTools::StatusTraceArrays(Hamilton_DriverTools::ACTION::COMPLETE,
                                              TRACE_LEVEL_DEBUG,
                                              strFunctionName,
                                              gThermoScientific_Cytomat_Interface_intTraceLevel,
                                              gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // GetLabwareIDs

    // --------------------------------------------------------------------------------------
    // function GetPlateByLabwareID
    // --------------------------------------------------------------------------------------
    function GetPlateByLabwareID(variable i_intModuleID,
                                 variable i_strLabwareID,
                                 variable i_blnWaitForFinish) variable
    {
      variable strFunctionName("GetPlateByLabwareID");
      variable strResponse(""), strParameter(""), strOriginalTowerShakerSettings("");
      variable blnStackerIsTowerShaker(hslFalse), blnTowerShakerWasShaking(hslFalse);
      variable intAbsoluteLabwareIDStoragePosition(0), intStacker(0), intStackerMax(0), intLevelMax(0);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckString(i_strLabwareID,
                                           "i_strLabwareID",
                                           strFunctionName,
                                           gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckBool(i_blnWaitForFinish,
                                         "i_blnWaitForFinish",
                                         strFunctionName,
                                         gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_strLabwareID = " + i_strLabwareID +
                                        ", i_blnWaitForFinish = " + IStr(i_blnWaitForFinish),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      // in case the selected stacker is a ToS it needs to be disabled
      if(gThermoScientific_Cytomat_Interface_arrIntAvailableDevices.GetAt(i_intModuleID) == CytomatType::C2_LINEAR)
      {
        if(!_SendCommand(i_intModuleID, "ch:pl", i_strLabwareID, TIMEOUT_SHORT, "", strFunctionName, "Unable to get absolute position of labware ID ", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
        if(!_ProcessResponse(i_intModuleID, strResponse, "pl", ResponseType::INTEGER, intAbsoluteLabwareIDStoragePosition, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

        if(!_GetMaxStackerAndLevel(i_intModuleID, 1, intStackerMax, intLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
        if(intAbsoluteLabwareIDStoragePosition <= intLevelMax) intStacker = 1;
        else intStacker = 2;

        if(!_DiableTowerShaker(i_intModuleID, intStacker, strFunctionName, blnStackerIsTowerShaker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings)) return(ASWGLOBAL::BOOL::FALSE);
      }

      if(!_DeviceSupportsInventoryManagement(i_intModuleID, strFunctionName))
      {
        if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
        return(ASWGLOBAL::BOOL::FALSE);
      }
      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName))
      {
        if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
        return(ASWGLOBAL::BOOL::FALSE);
      }

      strParameter = i_strLabwareID;
      if(!_SendCommand(i_intModuleID, HL_GET_PLATE_ID, strParameter, TIMEOUT_SHORT, "", strFunctionName, "Unable to get plate by labware ID ", strResponse))
      {
        if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
        return(ASWGLOBAL::BOOL::FALSE);
      }

      if(i_blnWaitForFinish == ASWGLOBAL::BOOL::TRUE)
      {
        if(!_WaitForReady(i_intModuleID, TIMEOUT_MEDIUM, "Waiting for device to accept command", strFunctionName))
        {
          if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
          return(ASWGLOBAL::BOOL::FALSE);
        }
      }
      // set the disabled ToS back to active in the option settings register
      if(blnStackerIsTowerShaker)
      {
        if(!_EnableTowerShaker(i_intModuleID, intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "Getting plate by labware ID complete with response: " + strResponse,
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // GetPlateByLabwareID

    // --------------------------------------------------------------------------------------
    // function GetPlateByPosition
    // --------------------------------------------------------------------------------------
    function GetPlateByPosition(variable i_intModuleID,
                                variable i_intStacker,
                                variable i_intLevel,
                                variable i_blnWaitForFinish) variable
    {
      variable strFunctionName("GetPlateByPosition");
      variable strResponse(""), strParameter(""), strOriginalTowerShakerSettings("");
      variable strStacker(""), strLevel("");
      variable intStackerMax(0), intLevelMax(0);
      variable blnStackerIsTowerShaker(hslFalse), blnTowerShakerWasShaking(hslFalse);

      // Get the max stacker and level capacity for the current used device
      if(!_GetMaxStackerAndLevel(i_intModuleID, i_intStacker, intStackerMax, intLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStacker,
                                                 "i_intStacker",
                                                 1,
                                                 intStackerMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intLevel,
                                                 "i_intLevel",
                                                 1,
                                                 intLevelMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckBool(i_blnWaitForFinish,
                                         "i_blnWaitForFinish",
                                         strFunctionName,
                                         gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intStacker = " + IStr(i_intStacker) +
                                        ", i_intLevel = " + IStr(i_intLevel) +
                                        ", i_blnWaitForFinish = " + IStr(i_blnWaitForFinish),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      // in case the selected stacker is a ToS it needs to be disabled
      if(gThermoScientific_Cytomat_Interface_arrIntAvailableDevices.GetAt(i_intModuleID) == CytomatType::C2_LINEAR)
      {
        if(!_DiableTowerShaker(i_intModuleID, i_intStacker, strFunctionName, blnStackerIsTowerShaker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings)) return(ASWGLOBAL::BOOL::FALSE);
      }

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName))
      {
        if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
        return(ASWGLOBAL::BOOL::FALSE);
      }

      strStacker = IStr(i_intStacker);
      strLevel = IStr(i_intLevel);
      strParameter = strStacker + " " + strLevel;
      if(!_SendCommand(i_intModuleID, HL_GET_PLATE, strParameter, TIMEOUT_SHORT, "", strFunctionName, "Unable to get plate by position ", strResponse))
      {
        if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
        return(ASWGLOBAL::BOOL::FALSE);
      }

      if(i_blnWaitForFinish == ASWGLOBAL::BOOL::TRUE)
      {
        if(!_WaitForReady(i_intModuleID, TIMEOUT_MEDIUM, "Waiting for device to accept command", strFunctionName))
        {
          if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
          return(ASWGLOBAL::BOOL::FALSE);
        }
      }
      // set the disabled ToS back to active in the option settings register
      if(blnStackerIsTowerShaker)
      {
        if(!_EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "Getting plate complete with response: " + strResponse,
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // GetPlateByPosition

    // --------------------------------------------------------------------------------------
    // function StorePlateByPosition
    // --------------------------------------------------------------------------------------
    function StorePlateByPosition(variable i_intModuleID,
                                  variable i_intStacker,
                                  variable i_intLevel,
                                  variable i_blnWaitForFinish) variable
    {
      variable strFunctionName("StorePlateByPosition");
      variable strResponse(""), strParameter(""), strTempResponse("");
      variable strStacker(""), strLevel(""), strOriginalTowerShakerSettings("");
      variable intStackerMax(0), intLevelMax(0);
      string strOccupationStatus(""), strOccupationStatusTrimmed("");
      variable blnStackerIsTowerShaker(hslFalse), blnTowerShakerWasShaking(hslFalse);

      // Get the max stacker and level capacity for the current used device
      if(!_GetMaxStackerAndLevel(i_intModuleID, i_intStacker, intStackerMax, intLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStacker,
                                                 "i_intStacker",
                                                 1,
                                                 intStackerMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intLevel,
                                                 "i_intLevel",
                                                 1,
                                                 intLevelMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckBool(i_blnWaitForFinish,
                                         "i_blnWaitForFinish",
                                         strFunctionName,
                                         gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intStacker = " + IStr(i_intStacker) +
                                        ", i_intLevel = " + IStr(i_intLevel) +
                                        ", i_blnWaitForFinish = " + IStr(i_blnWaitForFinish),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      // in case the selected stacker is a ToS it needs to be disabled
      if(gThermoScientific_Cytomat_Interface_arrIntAvailableDevices.GetAt(i_intModuleID) == CytomatType::C2_LINEAR)
      {
        if(!_DiableTowerShaker(i_intModuleID, i_intStacker, strFunctionName, blnStackerIsTowerShaker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings)) return(ASWGLOBAL::BOOL::FALSE);
      }

      strStacker = IStr(i_intStacker);
      strLevel = IStr(i_intLevel);
      strParameter = strStacker + " " + strLevel;

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName))
      {
        if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
        return(ASWGLOBAL::BOOL::FALSE);
      }
      
      if(gThermoScientific_Cytomat_Interface_arrblnHasP3Sensor.GetAt(i_intModuleID) || gThermoScientific_Cytomat_Interface_arrblnHasBarcodeReader.GetAt(i_intModuleID))
      {
        // get the inventory management characters
        if(!_GetInventoryManagementCharacters(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
        // check if the selected position is occupied or free
        if(!_SendCommand(i_intModuleID, CMD_OCCUPATION_STATUS, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to get occupancy status", strResponse))
        {
          if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
          return(ASWGLOBAL::BOOL::FALSE);
        }
        if(!_ProcessResponse(i_intModuleID, strResponse, "sd", ResponseType::STRING, strTempResponse, strFunctionName))
        {
          if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
          return(ASWGLOBAL::BOOL::FALSE);
        }
        strOccupationStatus = strTempResponse;
        strOccupationStatusTrimmed = strOccupationStatus.Left(1);
      
        if(strOccupationStatusTrimmed.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[0]) == 0 || strOccupationStatusTrimmed.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[3]) == 0)
        {
          if(!_SendCommand(i_intModuleID, HL_STORE_PLATE, strParameter, TIMEOUT_SHORT, "", strFunctionName, "Unable to store plate by position", strResponse))
          {
            if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
            return(ASWGLOBAL::BOOL::FALSE);
          }

          if(i_blnWaitForFinish == ASWGLOBAL::BOOL::TRUE)
          {
            if(!_WaitForReady(i_intModuleID, TIMEOUT_MEDIUM, "Waiting for device to accept command", strFunctionName))
            {
              if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
              return(ASWGLOBAL::BOOL::FALSE);
            }
          }
          return(ASWGLOBAL::BOOL::TRUE);
        }
        if(strOccupationStatusTrimmed.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[1]) == 0 || strOccupationStatusTrimmed.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[2]) == 0)
        {
          Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          "Stacker '" + IStr(i_intStacker) + "' at level '" + IStr(i_intLevel) + "' is already occupied!",
                                          strFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);

          if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
          return(ASWGLOBAL::BOOL::FALSE);
        }
        // case if a plate with labware ID is present
        else
        {
          Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          "Stacker '" + IStr(i_intStacker) + "' at level '" + IStr(i_intLevel) + "' is already occupied!",
                                          strFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);

          if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
          return(ASWGLOBAL::BOOL::FALSE);
        }
      }
      else
      {
        if(!_SendCommand(i_intModuleID, HL_STORE_PLATE, strParameter, TIMEOUT_SHORT, "", strFunctionName, "Unable to store plate by position", strResponse))
        {
          if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
          return(ASWGLOBAL::BOOL::FALSE);
        }

        if(i_blnWaitForFinish == ASWGLOBAL::BOOL::TRUE)
        {
          if(!_WaitForReady(i_intModuleID, TIMEOUT_MEDIUM, "Waiting for device to accept command", strFunctionName))
          {
            if(blnStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName);
            return(ASWGLOBAL::BOOL::FALSE);
          }
        }
      }
      // set the disabled ToS back to active in the option settings register
      if(blnStackerIsTowerShaker)
      {
        if(!_EnableTowerShaker(i_intModuleID, i_intStacker, blnTowerShakerWasShaking, strOriginalTowerShakerSettings, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "Store plate complete with response: " + strResponse,
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // StorePlateByPosition


    // --------------------------------------------------------------------------------------
    // function TransferPlate
    // --------------------------------------------------------------------------------------
    function TransferPlate(variable i_intModuleID,
                           variable i_intSourceStacker,
                           variable i_intSourceLevel,
                           variable i_intDestinationStacker,
                           variable i_intDestinationLevel,
                           variable i_blnWaitForFinish) variable
    {
      variable strFunctionName("TransferPlate");
      variable strResponse(""), strParameter(""), strOriginalSourceTowerShakerSettings(""), strOriginalDestinationTowerShakerSettings("");
      variable strStacker(""), strLevel("");
      variable intSourceStackerMax(0), intSourceLevelMax(0);
      variable intDestinationStackerMax(0), intDestinationLevelMax(0);
      variable blnSourceStackerIsTowerShaker(hslFalse), blnDestinationStackerIsTowerShaker(hslFalse), blnSourceTowerShakerWasShaking(hslFalse), blnDestinationTowerShakerWasShaking(hslFalse);

      // Get the max stacker and level capacity for the current used device
      if(!_GetMaxStackerAndLevel(i_intModuleID, i_intSourceStacker, intSourceStackerMax, intSourceLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetMaxStackerAndLevel(i_intModuleID, i_intDestinationStacker, intDestinationStackerMax, intDestinationLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intSourceStacker,
                                                 "i_intSourceStacker",
                                                 1,
                                                 intSourceStackerMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intSourceLevel,
                                                 "i_intSourceLevel",
                                                 1,
                                                 intSourceLevelMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intDestinationStacker,
                                                 "i_intDestinationStacker",
                                                 1,
                                                 intDestinationStackerMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);
                                                 
      if(Hamilton_DriverTools::CheckIntegerRange(i_intDestinationLevel,
                                                 "i_intDestinationLevel",
                                                 1,
                                                 intDestinationLevelMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckBool(i_blnWaitForFinish,
                                         "i_blnWaitForFinish",
                                         strFunctionName,
                                         gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intSourceStacker = " + IStr(i_intSourceStacker) +
                                        ", i_intSourceLevel = " + IStr(i_intSourceLevel) +
                                        ", i_intDestinationStacker = " + IStr(i_intDestinationStacker) +
                                        ", i_intDestinationLevel = " + IStr(i_intDestinationLevel) +
                                        ", i_blnWaitForFinish = " + IStr(i_blnWaitForFinish),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      // in case the selected stacker is a ToS it needs to be disabled
      if(gThermoScientific_Cytomat_Interface_arrIntAvailableDevices.GetAt(i_intModuleID) == CytomatType::C2_LINEAR)
      {
        if(!_DiableTowerShaker(i_intModuleID, i_intSourceStacker, strFunctionName, blnSourceStackerIsTowerShaker, blnSourceTowerShakerWasShaking, strOriginalSourceTowerShakerSettings)) return(ASWGLOBAL::BOOL::FALSE);
        if(!_DiableTowerShaker(i_intModuleID, i_intDestinationStacker, strFunctionName, blnDestinationStackerIsTowerShaker, blnDestinationTowerShakerWasShaking, strOriginalDestinationTowerShakerSettings)) return(ASWGLOBAL::BOOL::FALSE);
      }

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName))
      {
        if(blnSourceStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intSourceStacker, blnSourceTowerShakerWasShaking, strOriginalSourceTowerShakerSettings, strFunctionName);
        if(blnDestinationStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intDestinationStacker, blnDestinationTowerShakerWasShaking, strOriginalDestinationTowerShakerSettings, strFunctionName);
        return(ASWGLOBAL::BOOL::FALSE);
      }

      strStacker = IStr(i_intSourceStacker);
      strLevel = IStr(i_intSourceLevel);
      strParameter = strStacker + " " + strLevel;
      if(!_SendCommand(i_intModuleID, HL_MOVE_PLATE_TO_WAITPOSITION, strParameter, TIMEOUT_SHORT, "", strFunctionName, "Unable to get plate by position ", strResponse))
      {
        if(blnSourceStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intSourceStacker, blnSourceTowerShakerWasShaking, strOriginalSourceTowerShakerSettings, strFunctionName);
        if(blnDestinationStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intDestinationStacker, blnDestinationTowerShakerWasShaking, strOriginalDestinationTowerShakerSettings, strFunctionName);
        return(ASWGLOBAL::BOOL::FALSE);
      }
      
      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName))
      {
        if(blnSourceStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intSourceStacker, blnSourceTowerShakerWasShaking, strOriginalSourceTowerShakerSettings, strFunctionName);
        if(blnDestinationStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intDestinationStacker, blnDestinationTowerShakerWasShaking, strOriginalDestinationTowerShakerSettings, strFunctionName);
        return(ASWGLOBAL::BOOL::FALSE);
      }
      
      strStacker = IStr(i_intDestinationStacker);
      strLevel = IStr(i_intDestinationLevel);
      strParameter = strStacker + " " + strLevel;
      if(!_SendCommand(i_intModuleID, HL_STORE_PLATE_FROM_WAITPOSITION, strParameter, TIMEOUT_SHORT, "", strFunctionName, "Unable to get plate by position ", strResponse))
      {
        if(blnSourceStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intSourceStacker, blnSourceTowerShakerWasShaking, strOriginalSourceTowerShakerSettings, strFunctionName);
        if(blnDestinationStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intDestinationStacker, blnDestinationTowerShakerWasShaking, strOriginalDestinationTowerShakerSettings, strFunctionName);
        return(ASWGLOBAL::BOOL::FALSE);
      }

      if(i_blnWaitForFinish == ASWGLOBAL::BOOL::TRUE)
      {
        if(!_WaitForReady(i_intModuleID, TIMEOUT_MEDIUM, "Waiting for device to accept command", strFunctionName))
        {
        if(blnSourceStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intSourceStacker, blnSourceTowerShakerWasShaking, strOriginalSourceTowerShakerSettings, strFunctionName);
        if(blnDestinationStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intDestinationStacker, blnDestinationTowerShakerWasShaking, strOriginalDestinationTowerShakerSettings, strFunctionName);
          return(ASWGLOBAL::BOOL::FALSE);
        }
      }
      // set the disabled source ToS back to active in the option settings register
      if(blnSourceStackerIsTowerShaker)
      {
        if(blnSourceStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intSourceStacker, blnSourceTowerShakerWasShaking, strOriginalSourceTowerShakerSettings, strFunctionName);
      }
      // set the disabled destination ToS back to active in the option settings register
      if(blnDestinationStackerIsTowerShaker)
      {
        if(blnDestinationStackerIsTowerShaker) _EnableTowerShaker(i_intModuleID, i_intDestinationStacker, blnDestinationTowerShakerWasShaking, strOriginalDestinationTowerShakerSettings, strFunctionName);
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // TransferPlate

    // --------------------------------------------------------------------------------------
    // function GetEnvironment
    // --------------------------------------------------------------------------------------
    function GetEnvironment(variable i_intModuleID,
                            variable& o_fltTemperatureNominal,
                            variable& o_fltTemperatureActual,
                            variable& o_fltHumidityNominal,
                            variable& o_fltHumidityActual,
                            variable& o_fltCO2Nominal,
                            variable& o_fltCO2Actual,
                            variable& o_fltO2Nominal,
                            variable& o_fltO2Actual) variable
    {
      variable strFunctionName("GetEnvironment");
      variable strResponse(""), strParameter("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      o_fltTemperatureNominal = 21.0;
      o_fltTemperatureActual = 22.2;
      o_fltHumidityNominal = 23.1;
      o_fltHumidityActual = 24.5;
      o_fltCO2Nominal = 25.6;
      o_fltCO2Actual = 26.8;
      o_fltO2Nominal = 27.7;
      o_fltO2Actual = 28.9;

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      
      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, CMD_TEMPERATURE, strParameter, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to get temperature values", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetEnvironmentValues(i_intModuleID, strResponse, "it", o_fltTemperatureNominal, o_fltTemperatureActual, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, CMD_HUMIDITY, strParameter, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to get humidity values", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetEnvironmentValues(i_intModuleID, strResponse, "ih", o_fltHumidityNominal, o_fltHumidityActual, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, CMD_CO2, strParameter, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to get CO2 values", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetEnvironmentValues(i_intModuleID, strResponse, "ic", o_fltCO2Nominal, o_fltCO2Actual, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, CMD_O2, strParameter, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to get O2 values", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetEnvironmentValues(i_intModuleID, strResponse, "io", o_fltO2Nominal, o_fltO2Actual, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "o_fltTemperatureNominal = " + FStr(o_fltTemperatureNominal) +
                                        ", o_fltTemperatureActual = " + FStr(o_fltTemperatureActual) +
                                        ", o_fltHumidityNominal = " + FStr(o_fltHumidityNominal) +
                                        ", o_fltHumidityActual = " + FStr(o_fltHumidityActual) +
                                        ", o_fltCO2Nominal = " + FStr(o_fltCO2Nominal) +
                                        ", o_fltCO2Actual = " + FStr(o_fltCO2Actual) +
                                        ", o_fltO2Nominal = " + FStr(o_fltO2Nominal) +
                                        ", o_fltO2Actual = " + FStr(o_fltO2Actual),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // GetEnvironment

    // --------------------------------------------------------------------------------------
    // function GetSpecificEnvironment
    // --------------------------------------------------------------------------------------
    function GetSpecificEnvironment(variable i_intModuleID,
                                    variable i_intEnvironmentType,
                                    variable& o_fltValueNominal,
                                    variable& o_fltValueActual) variable
    {
      variable strFunctionName("GetSpecificEnvironment");
      variable strResponse(""), strEnvironmentCommand(""), strCommandHeader(""), strParameter("");
  
      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);
                                                 
      if(Hamilton_DriverTools::CheckIntegerRange(i_intEnvironmentType,
                                                 "i_intEnvironmentType",
                                                 1,
                                                 4,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intEnvironmentType = " + IStr(i_intEnvironmentType),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
                                        
      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      o_fltValueNominal = 21.0;
      o_fltValueActual = 22.2;
      
      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      
      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(i_intEnvironmentType == EnvironmentType::TEMPERATURE) {
        strEnvironmentCommand = CMD_TEMPERATURE;
        strCommandHeader = "it";
      }
      if(i_intEnvironmentType == EnvironmentType::HUMIDITY) {
        strEnvironmentCommand = CMD_HUMIDITY;
        strCommandHeader = "ih";
      }
      if(i_intEnvironmentType == EnvironmentType::CO2) {
        strEnvironmentCommand = CMD_CO2;
        strCommandHeader = "ic";
      }
      if(i_intEnvironmentType == EnvironmentType::O2) {
        strEnvironmentCommand = CMD_O2;
        strCommandHeader = "io";
      }

      if(!_SendCommand(i_intModuleID, strEnvironmentCommand, strParameter, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to get temperature values", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetEnvironmentValues(i_intModuleID, strResponse, strCommandHeader, o_fltValueNominal, o_fltValueActual, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);


      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "o_fltValueNominal = " + FStr(o_fltValueNominal) +
                                        ", o_fltValueActual = " + FStr(o_fltValueActual),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // GetSpecificEnvironment

    // --------------------------------------------------------------------------------------
    // function SetEnvironment
    // --------------------------------------------------------------------------------------
    function SetEnvironment(variable i_intModuleID,
                            variable i_fltTemperatureNominal,
                            variable i_fltHumidityNominal,
                            variable i_fltCO2Nominal,
                            variable i_fltO2Nominal) variable
    {
      variable strFunctionName("SetEnvironment");
      variable strResponse("");
      variable strTemperature(""), strHumidity(""), strCO2(""), strO2("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckFloat(i_fltTemperatureNominal,
                                          "i_fltTemperatureNominal",
                                          strFunctionName,
                                          gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckFloat(i_fltHumidityNominal,
                                          "i_fltHumidityNominal",
                                          strFunctionName,
                                          gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckFloat(i_fltCO2Nominal,
                                          "i_fltCO2Nominal",
                                          strFunctionName,
                                          gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckFloat(i_fltO2Nominal,
                                          "i_fltO2Nominal",
                                          strFunctionName,
                                          gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_fltTemperatureNominal = " + FStr(i_fltTemperatureNominal) +
                                        ", i_fltHumidityNominal = " + FStr(i_fltHumidityNominal) +
                                        ", i_fltCO2Nominal = " + FStr(i_fltCO2Nominal) +
                                        ", i_fltO2Nominal = " + FStr(i_fltO2Nominal),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      strTemperature = _FloatPrecisionFormatter(i_fltTemperatureNominal, 1, strFunctionName);
      strHumidity = _FloatPrecisionFormatter(i_fltHumidityNominal, 1, strFunctionName);
      strCO2 = _FloatPrecisionFormatter(i_fltCO2Nominal, 1, strFunctionName);
      strO2 = _FloatPrecisionFormatter(i_fltO2Nominal, 1, strFunctionName);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, LL_TEMPERATURE, strTemperature, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to set temperature values", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, LL_HUMIDITY, strHumidity, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to set humidity values", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, LL_CO2, strCO2, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to set CO2 values", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, LL_O2, strO2, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to set O2 values", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // SetEnvironment

    // --------------------------------------------------------------------------------------
    // function SetSpecificEnvironment
    // --------------------------------------------------------------------------------------
    function SetSpecificEnvironment(variable i_intModuleID,
                                    variable i_intEnvironmentType,
                                    variable i_fltValueNominal) variable
    {
      variable strFunctionName("SetSpecificEnvironment");
      variable strResponse(""), strValueNominal(""), strEnvironmentCommand("");
  
      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);
                                                 
      if(Hamilton_DriverTools::CheckIntegerRange(i_intEnvironmentType,
                                                 "i_intEnvironmentType",
                                                 1,
                                                 4,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckFloat(i_fltValueNominal,
                                          "i_fltValueNominal",
                                          strFunctionName,
                                          gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intEnvironmentType = " + IStr(i_intEnvironmentType) +
                                        ", i_fltValueNominal = " + FStr(i_fltValueNominal),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
                                        
      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      strValueNominal = _FloatPrecisionFormatter(i_fltValueNominal, 1, strFunctionName);
      
      if(i_intEnvironmentType == EnvironmentType::TEMPERATURE) strEnvironmentCommand = LL_TEMPERATURE;
      if(i_intEnvironmentType == EnvironmentType::HUMIDITY) strEnvironmentCommand = LL_HUMIDITY;
      if(i_intEnvironmentType == EnvironmentType::CO2) strEnvironmentCommand = LL_CO2;
      if(i_intEnvironmentType == EnvironmentType::O2) strEnvironmentCommand = LL_O2;
      
      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, strEnvironmentCommand, strValueNominal, TIMEOUT_MEDIUM, "", strFunctionName, "Unable to set temperature values", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // SetSpecificEnvironment

    // --------------------------------------------------------------------------------------
    // function SetPitch
    // --------------------------------------------------------------------------------------
    function SetPitch(variable i_intModuleID,
                      variable i_intStacker,
                      variable i_intPitch) variable
    {
      variable strFunctionName("SetPitch");
      variable strResponse("");
      variable intStackerMax(0), intLevelMax(0);
      variable strPitchValue("");
      
      // Get the max stacker and level capacity for the current used device
      // If 'i_intStacker' is set to 0 all stackers are set to the same pitch value, hence it is not important to know the max amount of stackers
      if(i_intStacker > 0) {
        if(!_GetMaxStackerAndLevel(i_intModuleID, i_intStacker, intStackerMax, intLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      }

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStacker,
                                                 "i_intStacker",
                                                 0,
                                                 intStackerMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intPitch,
                                                 "i_intPitch",
                                                 PITCH_MIN,
                                                 PITCH_MAX,     // TODO pitch max and min values
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);


      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        "i_intStacker = " + IStr(i_intStacker) +
                                        "i_intPitch = " + IStr(i_intPitch),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // By setting 'i_intStacker' to 0 all stackers are set to the same pitch value
      if(i_intStacker == 0) {
        if(!_SendCommand(i_intModuleID, SB_PITCH_ALL, IStr(i_intPitch), TIMEOUT_LONG, "", strFunctionName, "Unable to set pitch for all available stackers", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      } else {
          strPitchValue = IStr(i_intStacker) + " " + IStr(i_intPitch);
          if(!_SendCommand(i_intModuleID, SE_PITCH, strPitchValue, TIMEOUT_LONG, "", strFunctionName, "Unable to set stacker pitch", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      }

      // update the device configuration (max. storage, stackers, levels)
      if(!_GetDeviceConfig(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // SetPitch

    // --------------------------------------------------------------------------------------
    // function InventoryScanFull
    // --------------------------------------------------------------------------------------
    function InventoryScanFull(variable i_intModuleID,
                               variable i_blnWaitForFinish) variable
    {
      variable strFunctionName("InventoryScanFull");
      variable intStatusInventoryScan(0), intTempResponse(0);
      variable strResponse("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckBool(i_blnWaitForFinish,
                                         "i_blnWaitForFinish",
                                         strFunctionName,
                                         gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_blnWaitForFinish = " + IStr(i_blnWaitForFinish),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_DeviceSupportsInventoryManagement(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, HL_INVENTORY_SCAN, "", TIMEOUT_LONG, "", strFunctionName, "Unable to get inventory scan", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      if(i_blnWaitForFinish == ASWGLOBAL::BOOL::TRUE)
      {
        intStatusInventoryScan = hslTrue;
        while(intStatusInventoryScan)
        {

          if(!_SendCommand(i_intModuleID, CMD_INVENTORY_SCAN_STATUS, "", TIMEOUT_SHORT, "", strFunctionName, "Unable to get inventory scan status", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
          if(!_ProcessResponse(i_intModuleID, strResponse, "is", ResponseType::INTEGER, intTempResponse, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
          intStatusInventoryScan = intTempResponse;

          if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
          {
            Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::PROGRESS,
                                              TRACE_LEVEL_DEBUG,
                                              "State of inventory scan: " + IStr(intStatusInventoryScan),
                                              strFunctionName,
                                              gThermoScientific_Cytomat_Interface_intTraceLevel,
                                              gThermoScientific_Cytomat_Interface_strModuleName);
          }
          Hamilton_DriverTools::Delay(0.5, strFunctionName, gThermoScientific_Cytomat_Interface_strModuleName);
          if(intStatusInventoryScan == hslFalse) break;
        }
        if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);    

      return(ASWGLOBAL::BOOL::TRUE);
    } // InventoryScanFull

    // --------------------------------------------------------------------------------------
    // function InventoryScanPartial
    // --------------------------------------------------------------------------------------
    function InventoryScanPartial(variable i_intModuleID,
                                  variable i_intStartStacker,
                                  variable i_intStopStacker,
                                  variable i_blnWaitForFinish) variable
    {
      variable strFunctionName("InventoryScanPartial");
      variable strResponse(""), strScanRange("");
      variable intStartStackerMax(0), intStartLevelMax(0), intStopStackerMax(0), intStopLevelMax(0), intStopLevel(0);
      variable intStatusInventoryScan(0), intTempResponse(0);

      // update the device configuration (max. storage, stackers, levels)
      if(!_GetDeviceConfig(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // Get the max stacker and level capacity for the current used device
      if(!_GetMaxStackerAndLevel(i_intModuleID, i_intStartStacker, intStartStackerMax, intStartLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetMaxStackerAndLevel(i_intModuleID, i_intStopStacker, intStopStackerMax, intStopLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStartStacker,
                                                 "i_intStartStacker",
                                                 1,
                                                 intStartStackerMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStopStacker,
                                                 "i_intStopStacker",
                                                 1,
                                                 intStopStackerMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckBool(i_blnWaitForFinish,
                                         "i_blnWaitForFinish",
                                         strFunctionName,
                                         gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intStartStacker = " + IStr(i_intStartStacker) +
                                        ", i_intStopStacker = " + IStr(i_intStopStacker) +
                                        ", i_blnWaitForFinish = " + IStr(i_blnWaitForFinish),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      
      if(!_DeviceSupportsInventoryManagement(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      // get maximum levels for the specified stacker
      if(i_intModuleID == 0) intStopLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(i_intStopStacker - 1);
      if(i_intModuleID == 1) intStopLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(i_intStopStacker - 1);
      if(i_intModuleID == 2) intStopLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(i_intStopStacker - 1);
      if(i_intModuleID == 3) intStopLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(i_intStopStacker - 1);
      // scan starts always from level '1' to the maximum available level
      strScanRange = IStr(i_intStartStacker) + (" ") + IStr(1) + (" ") + IStr(i_intStopStacker) + (" ") + IStr(intStopLevel);
      if(!_SendCommand(i_intModuleID, HL_LOCATION_SCAN, strScanRange, TIMEOUT_LONG, "", strFunctionName, "Unable to get location scan", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(i_blnWaitForFinish == ASWGLOBAL::BOOL::TRUE)
      {
        intStatusInventoryScan = hslTrue;
        while(intStatusInventoryScan)
        {

          if(!_SendCommand(i_intModuleID, CMD_INVENTORY_SCAN_STATUS, "", TIMEOUT_SHORT, "", strFunctionName, "Unable to get inventory scan status", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
          if(!_ProcessResponse(i_intModuleID, strResponse, "is", ResponseType::INTEGER, intTempResponse, strFunctionName)) return(hslFalse);
          intStatusInventoryScan = intTempResponse;

          if(gThermoScientific_Cytomat_Interface_blnExtendedTrace)
          {
            Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::PROGRESS,
                                              TRACE_LEVEL_DEBUG,
                                              "State of inventory scan: " + IStr(intStatusInventoryScan),
                                              strFunctionName,
                                              gThermoScientific_Cytomat_Interface_intTraceLevel,
                                              gThermoScientific_Cytomat_Interface_strModuleName);
          }
          Hamilton_DriverTools::Delay(0.5, strFunctionName, gThermoScientific_Cytomat_Interface_strModuleName);
          if(intStatusInventoryScan == hslFalse) break;
        }
        if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      return(ASWGLOBAL::BOOL::TRUE);
    } // InventoryScanPartials

    //----------------------------------------------------------------------------------------------
    //function GetCytomatState
    //----------------------------------------------------------------------------------------------
    function GetCytomatState(variable i_intModuleID,
                             variable& o_blnBusy,
                             variable& o_blnReady,
                             variable& o_blnWarning,
                             variable& o_blnError,
                             variable& o_blnHandler,
                             variable& o_blnGate,
                             variable& o_blnDoor,
                             variable& o_blnTransfer) variable
    {
      variable strFunctionName("GetCytomatState");
      variable strResponse("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      o_blnBusy = ASWGLOBAL::BOOL::FALSE;
      o_blnReady = ASWGLOBAL::BOOL::FALSE;
      o_blnWarning = ASWGLOBAL::BOOL::FALSE;
      o_blnError = ASWGLOBAL::BOOL::FALSE;
      o_blnHandler = ASWGLOBAL::BOOL::FALSE;
      o_blnGate = ASWGLOBAL::BOOL::FALSE;
      o_blnDoor = ASWGLOBAL::BOOL::FALSE;
      o_blnTransfer = ASWGLOBAL::BOOL::FALSE;

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_CheckState(i_intModuleID,
                      o_blnBusy,
                      o_blnReady,
                      o_blnWarning,
                      o_blnError,
                      o_blnHandler,
                      o_blnGate,
                      o_blnDoor,
                      o_blnTransfer,
                      strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "o_blnBusy = " + IStr(o_blnBusy) +
                                        ", o_blnReady = " + IStr(o_blnReady) +
                                        ", o_blnWarning = " + IStr(o_blnWarning) +
                                        ", o_blnError = " + IStr(o_blnError) +
                                        ", o_blnHandler = " + IStr(o_blnHandler) +
                                        ", o_blnGate = " + IStr(o_blnGate) +
                                        ", o_blnDoor = " + IStr(o_blnDoor) +
                                        ", o_blnTransfer = " + IStr(o_blnTransfer),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      return (ASWGLOBAL::BOOL::TRUE);
    } // GetCytomatState

    //----------------------------------------------------------------------------------------------
    //function GetInventoryState
    //----------------------------------------------------------------------------------------------
    function GetInventoryState(variable i_intModuleID,
                               variable& o_blnInventoryValid) variable
    {
      variable strFunctionName("GetInventoryState");
      variable intStatusByte(0);
      variable strResponse(""), strProcessedResponse("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      o_blnInventoryValid = ASWGLOBAL::BOOL::FALSE;

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_SendCommand(i_intModuleID, CMD_OVERVIEW_STATUS, "", TIMEOUT_LONG, "", strFunctionName, "Unable to get overview status", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "bo", ResponseType::STRING, strProcessedResponse, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      intStatusByte = IVal("0x" + strProcessedResponse);

      if(intStatusByte & 0x0100) o_blnInventoryValid = hslTrue; else o_blnInventoryValid = hslFalse;

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "o_blnInventoryValid = " + IStr(o_blnInventoryValid),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      return (ASWGLOBAL::BOOL::TRUE);
    } // GetInventoryState

    //----------------------------------------------------------------------------------------------
    //function GetInventory
    //----------------------------------------------------------------------------------------------
    function GetInventory(variable i_intModuleID,
                          variable i_intStartStacker,
                          variable i_intStopStacker,
                          variable& o_arrIntStackerNumbers[],
                          variable& o_arrStrOccupationStatus[]) variable
    {
      variable strFunctionName("GetInventory");
      variable intAbsoluteStartPosition(0), intAbsoluteEndPosition(0), intMaxStoragePosition(0), intStart(0), intStop(0);
      variable intStartStackerMax(0), intStopStackerMax(0), intMaxStackerLevel(0), intIndex(0), intLevelIndex(0);
      variable intStartLevelMax(0), intStopLevelMax(0);
      variable strResponse(""), strTempResponse("");
      variable blnCaseMatched(hslFalse);
      string strOccupationStatus(""), strOccupationStatusTrimmed("");

      // update the device configuration (max. storage, stackers, levels)
      if(!_GetDeviceConfig(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // if only a part of the inventory is returned, the range of the stackers start from '1'
      if(i_intStartStacker != 0 && i_intStopStacker != 0)
      {
        // Get the max stacker and level capacity for the current used device
        if(!_GetMaxStackerAndLevel(i_intModuleID, i_intStartStacker, intStartStackerMax, intStartLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
        if(!_GetMaxStackerAndLevel(i_intModuleID, i_intStopStacker, intStopStackerMax, intStopLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
        
        if(Hamilton_DriverTools::CheckIntegerRange(i_intStartStacker,
                                                   "i_intStartStacker",
                                                   1,
                                                   intStartStackerMax,
                                                   strFunctionName,
                                                   gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

        if(Hamilton_DriverTools::CheckIntegerRange(i_intStopStacker,
                                                   "i_intStopStacker",
                                                   1,
                                                   intStopStackerMax,
                                                   strFunctionName,
                                                   gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);
      }
      // in case of returning all inventory values, the max stacker and level numbers are not needed and the stacker range starts form '0' and ends at '0'
      else
      { 
        if(Hamilton_DriverTools::CheckIntegerRange(i_intStartStacker,
                                                   "i_intStartStacker",
                                                   0,
                                                   intStartStackerMax,
                                                   strFunctionName,
                                                   gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

        if(Hamilton_DriverTools::CheckIntegerRange(i_intStopStacker,
                                                   "i_intStopStacker",
                                                   0,
                                                   intStopStackerMax,
                                                   strFunctionName,
                                                   gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);
      }
      
      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);       

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intStartStacker = " + IStr(i_intStartStacker) +
                                        ", i_intStopStacker = " + IStr(i_intStopStacker),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      o_arrIntStackerNumbers.SetSize(0);
      o_arrStrOccupationStatus.SetSize(0);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      o_arrIntStackerNumbers.AddAsLast("- Simulated - Stacker Number: 42");
      o_arrStrOccupationStatus.AddAsLast("- Simulated - Occupation Status: Free");

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      
      o_arrIntStackerNumbers.SetSize(0);
      o_arrStrOccupationStatus.SetSize(0);

      if(!_DeviceSupportsInventoryManagement(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetInventoryManagementCharacters(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      // Get the maximum storage position
      intMaxStoragePosition = gThermoScientific_Cytomat_Interface_arrIntMaxStorageCapacity.GetAt(i_intModuleID);
      
      // return values of the full inventory
      if(i_intStartStacker == 0 && i_intStopStacker == 0)
      {
        intAbsoluteStartPosition = 1;
        intAbsoluteEndPosition = intMaxStoragePosition + 1;
      }
      // return values of a single stacker or over the range of multiple stackers
      if(i_intStartStacker > 0 && i_intStopStacker > 0)
      {
        // calculate the absolute start position
        if(i_intStartStacker == 1)
        {
          intAbsoluteStartPosition = 1;
        }
        else
        {
          intAbsoluteStartPosition = 0;
          for(intIndex = 1; intIndex < i_intStartStacker; intIndex++)
          {
            // calculate the absolute position for the start
            if(i_intModuleID == 0) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(intIndex - 1);
            if(i_intModuleID == 1) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(intIndex - 1);
            if(i_intModuleID == 2) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(intIndex - 1);
            if(i_intModuleID == 3) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(intIndex - 1);
            intAbsoluteStartPosition = intAbsoluteStartPosition + intMaxStackerLevel;
          }
          // the +1 at the end is needed since level position in the stackers are one based
          intAbsoluteStartPosition = intAbsoluteStartPosition + 1;
        }
        // calculate the absolute end position
        intAbsoluteEndPosition = 0;
        for(intIndex = 1; intIndex < (i_intStopStacker + 1); intIndex++)
        {
          // get the maximum levels for each of the specified stackers and add them together to get the absolute end position
          if(i_intModuleID == 0) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(intIndex - 1);
          if(i_intModuleID == 1) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(intIndex - 1);
          if(i_intModuleID == 2) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(intIndex - 1);
          if(i_intModuleID == 3) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(intIndex - 1);
          intAbsoluteEndPosition = intAbsoluteEndPosition + intMaxStackerLevel;
        }
        // the +1 at the end is needed since level position in the stackers are one based
        intAbsoluteEndPosition =  intAbsoluteEndPosition + 1;
      }

      // check occupancy of every level and save it to the 'o_arrStrOccupationStatus' array
      for(intIndex = intAbsoluteStartPosition; intIndex < intAbsoluteEndPosition; intIndex++)
      {
        if(!_SendCommand(i_intModuleID, CMD_OCCUPATION_STATUS, IStr(intIndex), TIMEOUT_LONG, "", strFunctionName, "Unable to get occupancy status", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
        if(!_ProcessResponse(i_intModuleID, strResponse, "sd", ResponseType::STRING, strTempResponse, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
        strOccupationStatus = strTempResponse;
        // Trimm the whitespaces of occupation status string, e.g. from '-            ' to '-'
        strOccupationStatusTrimmed = Hamilton_DriverTools::TrimRight(strOccupationStatus, " ", strFunctionName, gThermoScientific_Cytomat_Interface_strModuleName);

        // search for the 'free' inventory management characters -> default: '-'
        if(strOccupationStatusTrimmed.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[0]) == 0 && strOccupationStatusTrimmed.GetLength() == 1)
        {
          o_arrStrOccupationStatus.AddAsLast(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[0]);
          blnCaseMatched = hslTrue;
        }
        // search for the 'free' inventory management characters -> default: '0'
        if(strOccupationStatusTrimmed.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[3]) == 0 && strOccupationStatusTrimmed.GetLength() == 1)
        {
          o_arrStrOccupationStatus.AddAsLast(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[3]);
          blnCaseMatched = hslTrue;
        }
        // search for the 'occupied' inventory management characters -> default: '?'
        if(strOccupationStatusTrimmed.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[1]) == 0 && strOccupationStatusTrimmed.GetLength() == 1)
        {
          o_arrStrOccupationStatus.AddAsLast(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[1]);
          blnCaseMatched = hslTrue;
        }
        // search for the 'occupied' inventory management characters -> default: '1'
        if(strOccupationStatusTrimmed.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[2]) == 0 && strOccupationStatusTrimmed.GetLength() == 1)
        {
          o_arrStrOccupationStatus.AddAsLast(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[2]);
          blnCaseMatched = hslTrue;
        }
        // if none of the previous conditions applied save the labware ID at the position
        if(blnCaseMatched == hslFalse && strOccupationStatusTrimmed.GetLength() > 1)
        {
          o_arrStrOccupationStatus.AddAsLast(strOccupationStatusTrimmed);
        }
        blnCaseMatched = hslFalse;
      }
      // get the stacker numbers for the array o_arrIntStackerNumbers
      // if the whole inventory is returned the start and stop stackers need to be reasigned
      if(i_intStartStacker == 0 || i_intStopStacker == 0)
      {
        i_intStartStacker = 1;
        // get the maximum levels for each of the specified stackers and add them together to get the absolute end position
        if(i_intModuleID == 0) i_intStopStacker = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetSize();
        if(i_intModuleID == 1) i_intStopStacker = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetSize();
        if(i_intModuleID == 2) i_intStopStacker = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetSize();
        if(i_intModuleID == 3) i_intStopStacker = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetSize();
      }
      // if only a part of the inventory is returned loop over the range between the start and stop stackers
      for(intIndex = i_intStartStacker; intIndex < i_intStopStacker + 1; intIndex++)
      {
        if(i_intModuleID == 0) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(intIndex - 1);
        if(i_intModuleID == 1) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(intIndex - 1);
        if(i_intModuleID == 2) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(intIndex - 1);
        if(i_intModuleID == 3) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(intIndex - 1);
        // append the current stacker number by the maximum level amount of the stacker
        for(intLevelIndex = 0; intLevelIndex < intMaxStackerLevel; intLevelIndex++)
        {
          o_arrIntStackerNumbers.AddAsLast(intIndex);
        }
      }
      
      Hamilton_DriverTools::StatusAddArray("o_arrIntStackerNumbers", o_arrIntStackerNumbers, gThermoScientific_Cytomat_Interface_strModuleName);
      Hamilton_DriverTools::StatusAddArray("o_arrStrOccupationStatus", o_arrStrOccupationStatus, gThermoScientific_Cytomat_Interface_strModuleName);

      Hamilton_DriverTools::StatusTraceArrays(Hamilton_DriverTools::ACTION::COMPLETE,
                                              TRACE_LEVEL_DEBUG,
                                              strFunctionName,
                                              gThermoScientific_Cytomat_Interface_intTraceLevel,
                                              gThermoScientific_Cytomat_Interface_strModuleName);

      return(ASWGLOBAL::BOOL::TRUE);
    } // GetInventory

    // --------------------------------------------------------------------------------------
    // function UpdateInventory
    // --------------------------------------------------------------------------------------
    function UpdateInventory(variable i_intModuleID,
                             variable i_intStartStacker,
                             variable i_intStartLevel,
                             variable i_intStopStacker,
                             variable i_intStopLevel,
                             variable i_varUpdatedStatus) variable
    {
      variable strFunctionName("UpdateInventory");
      variable intAbsoluteStartPosition(0), intAbsoluteEndPosition(0), intCurrentPosition(0), intMaxStoragePosition(0);
      variable intStartStackerMax(0), intStartLevelMax(0), intStopStackerMax(0), intStopLevelMax(0), intIndex(0), intMaxStackerLevel(0), intUpdatedStatus(0);
      variable strResponse(""), strTempResponse(""), strInventoryStatus(""), strParameter(""), strUpdateStatusType("");
      variable blnIsConstant(hslFalse);

      // update the device configuration (max. storage, stackers, levels)
      if(!_GetDeviceConfig(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      // if only a part of the inventory is returned, the range of the stackers start from '1'
      if(i_intStartStacker >= 1 && i_intStopStacker >= 1)
      {
        // Get the max stacker and level capacity for the current used device
        if(!_GetMaxStackerAndLevel(i_intModuleID, i_intStartStacker, intStartStackerMax, intStartLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
        if(!_GetMaxStackerAndLevel(i_intModuleID, i_intStopStacker, intStopStackerMax, intStopLevelMax, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      }

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStartStacker,
                                                 "i_intStartStacker",
                                                 0,
                                                 intStartStackerMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStartLevel,
                                                 "i_intStartLevel",
                                                 0,
                                                 intStartLevelMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStopStacker,
                                                 "i_intStopStacker",
                                                 0,
                                                 intStopStackerMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStopLevel,
                                                 "i_intStopLevel",
                                                 0,
                                                 intStopLevelMax,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      strUpdateStatusType = GetType(i_varUpdatedStatus);
      if(strUpdateStatusType == "i")
      {
        if(Hamilton_DriverTools::CheckIntegerRange(i_varUpdatedStatus,
                                                   "i_varUpdatedStatus",
                                                   0,
                                                   1,
                                                   strFunctionName,
                                                   gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);
        intUpdatedStatus = i_varUpdatedStatus;
        blnIsConstant = hslTrue;
        i_varUpdatedStatus = IStr(i_varUpdatedStatus);
      }
      if(strUpdateStatusType == "s")
      {
        if(Hamilton_DriverTools::CheckString(i_varUpdatedStatus,
                                             "i_varUpdatedStatus",
                                             strFunctionName,
                                             gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);
        // check if the updated staus is one of the constant values
        if(i_varUpdatedStatus == "0" || i_varUpdatedStatus == "1")
        {
          intUpdatedStatus = IVal(i_varUpdatedStatus);
          blnIsConstant = hslTrue;
        }
        blnIsConstant = hslFalse;
      }
      if(strUpdateStatusType != "i" && strUpdateStatusType != "s")
      {
        Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE_WITH_ERROR,
                                          TRACE_LEVEL_RELEASE,
                                          "Variable 'i_varUpdatedStatus' was not of type Int or String!",
                                          strFunctionName,
                                          gThermoScientific_Cytomat_Interface_intTraceLevel,
                                          gThermoScientific_Cytomat_Interface_strModuleName);
        return(ASWGLOBAL::BOOL::FALSE);
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intStartStacker = " + IStr(i_intStartStacker) +
                                        ", i_intStartLevel = " + IStr(i_intStartLevel) +
                                        ", i_intStopStacker = " + IStr(i_intStopStacker) +
                                        ", i_intStopLevel = " + IStr(i_intStopLevel) +
                                        ", i_varUpdatedStatus = " + i_varUpdatedStatus,
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_DeviceSupportsInventoryManagement(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetInventoryManagementCharacters(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // Get the maximum storage position
      intMaxStoragePosition = gThermoScientific_Cytomat_Interface_arrIntMaxStorageCapacity.GetAt(i_intModuleID);
      
      // update the inventory for the all available stackers
      if(i_intStartStacker == 0 && i_intStartLevel == 0 && i_intStopStacker == 0 && i_intStopLevel == 0)
      {
        intAbsoluteStartPosition = 1;
        intAbsoluteEndPosition = intMaxStoragePosition + 1;
      }


      // update the inventory for one or more stackers
      if(i_intStartStacker >= 1 && i_intStartLevel == 0 && i_intStopStacker >= 1 && i_intStopLevel == 0)
      {
        // calculate the absolute start position
        if(i_intStartStacker == 1)
        {
          intAbsoluteStartPosition = 1;
        }
        else
        {
          intAbsoluteStartPosition = 0;
          for(intIndex = 1; intIndex < i_intStartStacker; intIndex++)
          {
            // calculate the absolute position for the start
            if(i_intModuleID == 0) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(intIndex - 1);
            if(i_intModuleID == 1) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(intIndex - 1);
            if(i_intModuleID == 2) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(intIndex - 1);
            if(i_intModuleID == 3) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(intIndex - 1);
            intAbsoluteStartPosition = intAbsoluteStartPosition + intMaxStackerLevel;
          }
          // the +1 at the end is needed since level position in the stackers are one based
          intAbsoluteStartPosition = intAbsoluteStartPosition + 1;
        }
        // calculate the absolute end position
        if(i_intStopStacker == 1)
        {
          if(i_intModuleID == 0) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(0);
          if(i_intModuleID == 1) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(0);
          if(i_intModuleID == 2) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(0);
          if(i_intModuleID == 3) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(0);
          intAbsoluteEndPosition = intMaxStackerLevel + 1;
        }
        else
        {
          intAbsoluteEndPosition = 0;
          for(intIndex = 1; intIndex < (i_intStopStacker + 1); intIndex++)
          {
            // get the maximum levels for each of the specified stackers and add them together to get the absolute end position
            if(i_intModuleID == 0) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(intIndex - 1);
            if(i_intModuleID == 1) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(intIndex - 1);
            if(i_intModuleID == 2) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(intIndex - 1);
            if(i_intModuleID == 3) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(intIndex - 1);
            intAbsoluteEndPosition = intAbsoluteEndPosition + intMaxStackerLevel;
          }
          // the +1 at the end is needed since level position in the stackers are one based
          intAbsoluteEndPosition =  intAbsoluteEndPosition + 1;
        }
      }


      // update the inventory from an specified start to stop position
      if(i_intStartStacker >= 1 && i_intStartLevel >= 1 && i_intStopStacker >= 1 && i_intStopLevel >= 1)
      {
        // calculate the absolute start position
        if(i_intStartStacker == 1)
        {
          intAbsoluteStartPosition = i_intStartLevel;
        }
        else
        {
          intAbsoluteStartPosition = 0;
          for(intIndex = 1; intIndex < i_intStartStacker; intIndex++)
          {
            // calculate the absolute position for the start
            if(i_intModuleID == 0) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(intIndex - 1);
            if(i_intModuleID == 1) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(intIndex - 1);
            if(i_intModuleID == 2) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(intIndex - 1);
            if(i_intModuleID == 3) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(intIndex - 1);
            intAbsoluteStartPosition = intAbsoluteStartPosition + intMaxStackerLevel;
          }
          // the +1 at the end is needed since level position in the stackers are one based
          intAbsoluteStartPosition = intAbsoluteStartPosition + i_intStartLevel;
        }
        // calculate the absolute end position
        if(i_intStopStacker == 1)
        {
          intAbsoluteEndPosition = i_intStopLevel + 1;
        }
        else
        {
          intAbsoluteEndPosition = 0;
          for(intIndex = 1; intIndex < i_intStopStacker; intIndex++)
          {
            // get the maximum levels for each of the specified stackers and add them together to get the absolute end position
            if(i_intModuleID == 0) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(intIndex - 1);
            if(i_intModuleID == 1) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(intIndex - 1);
            if(i_intModuleID == 2) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(intIndex - 1);
            if(i_intModuleID == 3) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(intIndex - 1);
            intAbsoluteEndPosition = intAbsoluteEndPosition + intMaxStackerLevel;
          }
          // the +1 at the end is needed since level position in the stackers are one based
          intAbsoluteEndPosition =  intAbsoluteEndPosition + i_intStopLevel + 1;        
        }

      }

      if(blnIsConstant && intUpdatedStatus == OccupationStatus::FREE)
      {
         if(!_SendCommand(i_intModuleID, "rs:iv", IStr(intAbsoluteStartPosition) + " " + IStr(intAbsoluteEndPosition - 1), TIMEOUT_LONG, "", strFunctionName, "Unable to get occupancy status", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      }
      else
      {
         if(blnIsConstant && intUpdatedStatus == OccupationStatus::OCCUPIED)
         {
            // case where the updated status is a constant
            if(intUpdatedStatus == OccupationStatus::OCCUPIED) strInventoryStatus = gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[1];
         }
         else
         {
           // case where the updated status is a labware id
           strInventoryStatus = i_varUpdatedStatus;
         }

         for(intCurrentPosition = intAbsoluteStartPosition; intCurrentPosition < intAbsoluteEndPosition; intCurrentPosition++)
         {
           strParameter = IStr(intCurrentPosition) + " " + strInventoryStatus;
           if(!_SendCommand(i_intModuleID, SE_OCCUPATION_STATUS, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to get occupancy status", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
         }
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // UpdateInventory

    // --------------------------------------------------------------------------------------
    // function GetFreeStoragePositions
    // --------------------------------------------------------------------------------------
    function GetFreeStoragePositions(variable i_intModuleID,
                                     variable& o_intFreeStoragePositions,
                                     variable& o_arrIntStackerNumbers[],
                                     variable& o_arrIntLevelNumbers[]) variable
    {
      variable intSelectedStacker(0), intCurrentStacker(1), intCurrentLevel(1), intNumberOfStackers(0), intMaxStoragePosition(0);
      variable intStacker(1), intIndex(1), intStackerMax(0), intCurrentMaxLevels(0), intSelectedStackerLimit(0);
      variable arrIntCurrentStackerAvailableLevels[](0);
      variable strResponse(""), strTempResponse("");
      string strOccupationStatus(""), strOccupationStatusTrimmed("");
      variable strFunctionName("GetFreeStoragePositions");
      
      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);
                                         
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      o_intFreeStoragePositions = 45;                                         
      o_arrIntStackerNumbers.SetSize(0);
      o_arrIntLevelNumbers.SetSize(0);
      
      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      o_arrIntStackerNumbers.AddAsLast("2 - Simulated -");
      o_arrIntLevelNumbers.AddAsLast("4 - Simulated -");
      
      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      
      o_arrIntStackerNumbers.SetSize(0);
      o_arrIntLevelNumbers.SetSize(0);

      if(!_DeviceSupportsInventoryManagement(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetInventoryManagementCharacters(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, CMD_GET_FREE_STORAGE_CAPACITY, "", TIMEOUT_LONG, "", strFunctionName, "Unable to send firmware command", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pf", ResponseType::INTEGER, o_intFreeStoragePositions, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::PROGRESS,
                                        TRACE_LEVEL_DEBUG,
                                        "o_intFreeStoragePositions = '" + IStr(o_intFreeStoragePositions) + "'",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      
      if(o_intFreeStoragePositions > 0)
      {
        // Get the current max storage capacity
        if(!_GetDeviceConfig(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

        // extract all levels from the response and store them according to the used ModuleID
        intNumberOfStackers = gThermoScientific_Cytomat_Interface_arrIntAvailableStackers.GetAt(i_intModuleID);
        intMaxStoragePosition = gThermoScientific_Cytomat_Interface_arrIntMaxStorageCapacity.GetAt(i_intModuleID);
      
        // Get the max levels for each stacker
        for(intStacker = 1; intStacker < intNumberOfStackers + 1; intStacker++)
        {
          if(!_GetMaxStackerAndLevel(i_intModuleID, intStacker, intStackerMax, intCurrentMaxLevels, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
          arrIntCurrentStackerAvailableLevels.AddAsLast(intCurrentMaxLevels);
        }
      
        intSelectedStackerLimit = arrIntCurrentStackerAvailableLevels.GetAt(intSelectedStacker);
      
        for(intIndex = 1; intIndex < intMaxStoragePosition + 1; intIndex++)
        {
          // In case the current stacker limit is exceeded, the stacker and level positions are updated
          if(intSelectedStackerLimit < intIndex)
          {
            intSelectedStacker = intSelectedStacker + 1;
            intSelectedStackerLimit = intSelectedStackerLimit + arrIntCurrentStackerAvailableLevels.GetAt(intSelectedStacker);
            intCurrentStacker = intCurrentStacker + 1;
            intCurrentLevel = 1;
          }
      
          if(!_SendCommand(i_intModuleID, CMD_OCCUPATION_STATUS, IStr(intIndex), TIMEOUT_LONG, "", strFunctionName, "Unable to get occupancy status", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
          if(!_ProcessResponse(i_intModuleID, strResponse, "sd", ResponseType::STRING, strTempResponse, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
          strOccupationStatus = strTempResponse;
          // Trimm the whitespaces of occupation status string, e.g. from '-            ' to '-'
          strOccupationStatusTrimmed = Hamilton_DriverTools::TrimRight(strOccupationStatus, " ", strFunctionName, gThermoScientific_Cytomat_Interface_strModuleName);

          // search for the 'free' inventory management characters -> default: [0] = '-' and [3] = '0'
          if(strOccupationStatusTrimmed.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[0]) == 0 && strOccupationStatusTrimmed.GetLength() == 1 ||
             strOccupationStatusTrimmed.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[3]) == 0 && strOccupationStatusTrimmed.GetLength() == 1)
          {
            o_arrIntStackerNumbers.AddAsLast(intCurrentStacker);
            o_arrIntLevelNumbers.AddAsLast(intCurrentLevel);
          }
          intCurrentLevel++;
        }
      }

      Hamilton_DriverTools::StatusAddArray("o_arrIntStackerNumbers", o_arrIntStackerNumbers, gThermoScientific_Cytomat_Interface_strModuleName);
      Hamilton_DriverTools::StatusAddArray("o_arrIntLevelNumbers", o_arrIntLevelNumbers, gThermoScientific_Cytomat_Interface_strModuleName);

      Hamilton_DriverTools::StatusTraceArrays(Hamilton_DriverTools::ACTION::COMPLETE,
                                              TRACE_LEVEL_DEBUG,
                                              strFunctionName,
                                              gThermoScientific_Cytomat_Interface_intTraceLevel,
                                              gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // GetFreeStoragePositions

    // --------------------------------------------------------------------------------------
    // function SendFirmwareCommand
    // --------------------------------------------------------------------------------------
    function SendFirmwareCommand(variable i_intModuleID,
                                 variable i_strCommand,
                                 variable i_blnWaitForFinish,
                                 variable& o_strResponse) variable
    {
      variable strFunctionName("SendFirmwareCommand");
      variable strResponse("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);
                                                 
      if(Hamilton_DriverTools::CheckString(i_strCommand,
                                           "i_strCommand",
                                           strFunctionName,
                                           gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckBool(i_blnWaitForFinish,
                                         "i_blnWaitForFinish",
                                         strFunctionName,
                                         gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_strCommand = " + i_strCommand +
                                        ", i_blnWaitForFinish = " + IStr(i_blnWaitForFinish),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      o_strResponse = "- Simulated -";

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_SendCommand(i_intModuleID, i_strCommand, "", TIMEOUT_LONG, "", strFunctionName, "Unable to send firmware command", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      o_strResponse = strResponse;
      
      if(i_blnWaitForFinish == ASWGLOBAL::BOOL::TRUE)
      {
        if(!_WaitForReady(i_intModuleID, TIMEOUT_LONG, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      }
      
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "Response of firmware command '" + i_strCommand + "' is: " + strResponse,
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // SendFirmwareCommand

    // --------------------------------------------------------------------------------------
    // function MoveTransferStation
    // --------------------------------------------------------------------------------------
    function MoveTransferStation(variable i_intModuleID,
                                 variable i_intPosition,
                                 variable i_blnWaitForFinish) variable
    {
      variable strFunctionName("MoveTransferStation");
      variable strResponse(""), strPosition("");
      string strSensorResponse(""), strSensorState("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);
                                                 
      if(Hamilton_DriverTools::CheckIntegerRange(i_intPosition,
                                                 "i_intPosition",
                                                 1,
                                                 2,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckBool(i_blnWaitForFinish,
                                         "i_blnWaitForFinish",
                                         strFunctionName,
                                         gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intPosition = " + IStr(i_intPosition) +
                                        ", i_blnWaitForFinish = " + IStr(i_blnWaitForFinish),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      // get sensor states
      if(!_SendCommand(i_intModuleID, CMD_GET_SENSOR_STATUS, "", TIMEOUT_LONG, "", strFunctionName, "Unable to send firmware command", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "ts", ResponseType::STRING, strResponse, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      strSensorResponse = strResponse;
      strSensorState = "0x" + strSensorResponse;
      // check if TS is already in position 1
      if(i_intPosition == TransferStation::POSITION_1)
      {
        if(IVal(strSensorState) & 0x00010000)
        {
                Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "Transfer station is already in position 1!",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
          return(ASWGLOBAL::BOOL::TRUE);
        }
      }
      // check if TS is already in position 2
      if(i_intPosition == TransferStation::POSITION_2)
      {
        if(IVal(strSensorState) & 0x00020000)
        {
                Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "Transfer station is already in position 2!",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
          return(ASWGLOBAL::BOOL::TRUE);
        }
      }

      strPosition = IStr(i_intPosition);
      if(!_SendCommand(i_intModuleID, SB_MOVE_TRANSVERSTATION, strPosition, TIMEOUT_LONG, "", strFunctionName, "Unable to send firmware command", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(i_blnWaitForFinish == ASWGLOBAL::BOOL::TRUE)
      {
        if(!_WaitForReady(i_intModuleID, TIMEOUT_LONG, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      }
      
      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // MoveTransferStation

    // --------------------------------------------------------------------------------------
    // function GetFirstFreeStoragePosition
    // --------------------------------------------------------------------------------------
    function GetFirstFreeStoragePosition(variable i_intModuleID,
                                         variable& o_intStacker,
                                         variable& o_intLevel) variable
    {
      const variable NoSemicolonFound(-1);
      variable strFunctionName("GetFirstFreeStoragePosition");
      variable intStackerIndex(0), intLevelIndex(0), intMaxStackerLevel(0), intNumberOfStackers(0), intSemicolonPosition(0);
      string strResponse(""), strCurrentLevelOccupationStatus(""), strTemp(""), strTrimmedOccupationStatus(""), strOccupationStatus("");
      string arrStrStackerOccupationStatusValues[];
      variable tempValue("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      o_intStacker = 22;                  
      o_intLevel = 11;

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
      
      if(!_DeviceSupportsInventoryManagement(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_GetInventoryManagementCharacters(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // update the device configuration (max. storage, stackers, levels)
      if(!_GetDeviceConfig(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      // extract all levels from the response and store them according to the used ModuleID
      intNumberOfStackers = gThermoScientific_Cytomat_Interface_arrIntAvailableStackers.GetAt(i_intModuleID);
      
      for(intStackerIndex = 1; intStackerIndex < intNumberOfStackers + 1; intStackerIndex++)
      {
        // reset occupation status array for each stacker evaluation
        arrStrStackerOccupationStatusValues.SetSize(0);
        // get the occupation status for every level of the current stacker
        if(!_SendCommand(i_intModuleID, CMD_GETLABWARE_ID, IStr(intStackerIndex), TIMEOUT_SHORT, "", strFunctionName, "Unable to get occupation status of stacker", strResponse)) return(hslFalse);
        if(!_ProcessResponse(i_intModuleID, strResponse, "bx", ResponseType::STRING, strTemp, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
        
        // get the maximum levels for each of the specified stackers and add them together to get the absolute end position
        if(i_intModuleID == 0) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_1.GetAt(intStackerIndex - 1);
        if(i_intModuleID == 1) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_2.GetAt(intStackerIndex - 1);
        if(i_intModuleID == 2) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_3.GetAt(intStackerIndex - 1);
        if(i_intModuleID == 3) intMaxStackerLevel = gThermoScientific_Cytomat_Interface_arrIntAvailableLevels_Device_4.GetAt(intStackerIndex - 1);
        // exstract the occupation status for one stacker
        for(intLevelIndex = 1; intLevelIndex < intMaxStackerLevel + 1; intLevelIndex++)
        {
          intSemicolonPosition = strTemp.Find(";");
          if(intLevelIndex == intMaxStackerLevel && intSemicolonPosition == NoSemicolonFound) // case for the last stacker position
          {
            strCurrentLevelOccupationStatus = strTemp.Mid(0, strTemp.GetLength());
          }
          else
          {
            strCurrentLevelOccupationStatus = strTemp.Mid(0, intSemicolonPosition);
            strTemp = strTemp.Mid(intSemicolonPosition + 1, strTemp.GetLength() - intSemicolonPosition);
          }
          strTrimmedOccupationStatus = Hamilton_DriverTools::TrimRight(strCurrentLevelOccupationStatus, " ", strFunctionName, gThermoScientific_Cytomat_Interface_strModuleName);
          arrStrStackerOccupationStatusValues.AddAsLast(strTrimmedOccupationStatus);
        }

        for(intLevelIndex = 1; intLevelIndex < arrStrStackerOccupationStatusValues.GetSize() + 1; intLevelIndex++)
        {
          strOccupationStatus = arrStrStackerOccupationStatusValues.GetAt(intLevelIndex - 1);

          if(strOccupationStatus.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[0]) == 0 && strOccupationStatus.GetLength() == 1 ||
             strOccupationStatus.Compare(gThermoScientific_Cytomat_Interface_arrStrInventoryManagementCharacters[3]) == 0 && strOccupationStatus.GetLength() == 1)
          {
            o_intStacker = intStackerIndex;
            o_intLevel = intLevelIndex;
            
            Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                              TRACE_LEVEL_DEBUG,
                                              "o_intStacker = '" + IStr(o_intStacker) +
                                              "', o_intLevel = '" + IStr(o_intLevel) + "'",
                                              strFunctionName,
                                              gThermoScientific_Cytomat_Interface_intTraceLevel,
                                              gThermoScientific_Cytomat_Interface_strModuleName);
            return(ASWGLOBAL::BOOL::TRUE);
          }
        }
      }
      
      o_intStacker = -1;
      o_intLevel = -1;

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "No empty positions found",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
                                        
      return(ASWGLOBAL::BOOL::TRUE);
    } // GetFirstFreeStoragePosition

    //----------------------------------------------------------------------------------------------
    //function GetLastError
    //----------------------------------------------------------------------------------------------
    function GetLastError(variable i_intModuleID,
                          variable& o_intErrorCode,
                          variable& o_strErrorMessage) variable
    {
      const variable fltResetTimout(15.0);
      variable strFunctionName("GetLastError");
      variable blnBusy(hslTrue), blnReady(hslFalse), blnWarning(hslFalse), blnError(hslFalse), blnHandler(hslFalse), blnGate(hslFalse), blnDoor(hslFalse), blnTransfer(hslFalse);
      variable strResponse("");
      variable intStatusByte(0), intCurrentTraceLevel;
      variable strErrorStatus("");
      timer gdlErrorResetTimout;

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      o_intErrorCode = 0;
      o_strErrorMessage = "No error";

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_SendCommand(i_intModuleID, CMD_ERROR_STATUS, "", TIMEOUT_LONG, "", strFunctionName, "Unable to get overview status", strErrorStatus)) return(ASWGLOBAL::BOOL::FALSE);
      
      o_strErrorMessage = _HandleErrorMessage(strErrorStatus);
      if(!_ProcessResponse(i_intModuleID, strErrorStatus, "be", ResponseType::INTEGER, o_intErrorCode, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::PROGRESS,
                              TRACE_LEVEL_RELEASE,
                              "Waiting to reset error",
                              strFunctionName,
                              gThermoScientific_Cytomat_Interface_intTraceLevel,
                              gThermoScientific_Cytomat_Interface_strModuleName);

      gdlErrorResetTimout.SetTimer(hslInfinite);

      // in case of tracelevel debug turn off the traces for the comming _CheckState function
      if(gThermoScientific_Cytomat_Interface_blnExtendedTrace == hslFalse)
      {
        intCurrentTraceLevel = gThermoScientific_Cytomat_Interface_intTraceLevel;
        gThermoScientific_Cytomat_Interface_intTraceLevel = TRACE_LEVEL_RELEASE;
      }

      while(gdlErrorResetTimout.GetElapsedTime() < fltResetTimout)
      {
        Hamilton_DriverTools::Delay(1.0, strFunctionName, gThermoScientific_Cytomat_Interface_strModuleName);
        if(!_CheckState(i_intModuleID, blnBusy, blnReady, blnWarning, blnError, blnHandler, blnGate, blnDoor, blnTransfer, strFunctionName))
        {
          break;
        }
        if(blnBusy == hslFalse)
        {
          if(!_SendCommand(i_intModuleID, RS_RESET_ERROR, "", TIMEOUT_SHORT, "", strFunctionName, "Unable to reset error bit", strResponse)) return(hslFalse);
          break;
        }
      }

      if(gThermoScientific_Cytomat_Interface_blnExtendedTrace == hslFalse)
      {
        gThermoScientific_Cytomat_Interface_intTraceLevel = intCurrentTraceLevel;
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::PROGRESS,
                              TRACE_LEVEL_RELEASE,
                              "Error is reset",
                              strFunctionName,
                              gThermoScientific_Cytomat_Interface_intTraceLevel,
                              gThermoScientific_Cytomat_Interface_strModuleName);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "o_intErrorCode = " + IStr(o_intErrorCode) +
                                        ", o_strErrorMessage = '" + o_strErrorMessage + "'",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      return (ASWGLOBAL::BOOL::TRUE);
    } // GetLastError

    // --------------------------------------------------------------------------------------
    // function TowerShakerGetParameters
    // --------------------------------------------------------------------------------------
    function TowerShakerGetParameters(variable i_intModuleID,
                                      variable& o_intNumberOfToS,
                                      variable& o_intFrequencyToS1,
                                      variable& o_intFrequencyToS2,
                                      variable& o_intStatusToS1,
                                      variable& o_intStatusToS2) variable
    {
      variable strFunctionName("TowerShakerGetParameters");
      variable intTosParameter(0), intCurrentDevice(0);
      variable strResponse("");
      string strTempResponse("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanShake, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      o_intNumberOfToS = 2;
      o_intFrequencyToS1 = 88;
      o_intFrequencyToS2 = 77;
      o_intStatusToS1 = 0;
      o_intStatusToS2 = 1;

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, "01", TIMEOUT_LONG, "", strFunctionName, "Unable to get number of installed tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::INTEGER, o_intNumberOfToS, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, "20", TIMEOUT_LONG, "", strFunctionName, "Unable to get frequency of tower shaker 1", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::INTEGER, o_intFrequencyToS1, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, "21", TIMEOUT_LONG, "", strFunctionName, "Unable to get frequency of tower shaker 2", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::INTEGER, o_intFrequencyToS2, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, "30", TIMEOUT_LONG, "", strFunctionName, "Unable to get status of tower shaker 1", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::INTEGER, o_intStatusToS1, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, "31", TIMEOUT_LONG, "", strFunctionName, "Unable to get status of tower shaker 2", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::INTEGER, o_intStatusToS2, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "o_intNumberOfToS = " + IStr(o_intNumberOfToS) +
                                        ", o_intFrequencyToS1 = " + IStr(o_intFrequencyToS1) +
                                        ", o_intFrequencyToS2 = " + IStr(o_intFrequencyToS2) +
                                        ", o_intStatusToS1 = " + IStr(o_intStatusToS1) +
                                        ", o_intStatusToS2 = " + IStr(o_intStatusToS2),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // TowerShakerGetParameters

    // --------------------------------------------------------------------------------------
    // function TowerShakerSetParameters
    // --------------------------------------------------------------------------------------
    function TowerShakerSetParameters(variable i_intModuleID,
                                      variable i_intNumberOfToS,
                                      variable i_intFrequencyToS1,
                                      variable i_intFrequencyToS2,
                                      variable i_intStatusToS1,
                                      variable i_intStatusToS2) variable
    {
      variable strFunctionName("TowerShakerSetParameters");
      variable intTosParameter(0), intCurrentDevice(0);
      variable strResponse(""), strParameter("");
      string strTempResponse("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intNumberOfToS,
                                                 "i_intNumberOfToS",
                                                 0,
                                                 2,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intFrequencyToS1,
                                                 "i_intFrequencyToS1",
                                                 0,
                                                 9999,                // TODO max frequency
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intFrequencyToS2,
                                                 "i_intFrequencyToS2",
                                                 0,
                                                 9999,                // TODO max frequency
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStatusToS1,
                                                 "i_intStatusToS1",
                                                 0,
                                                 1,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStatusToS2,
                                                 "i_intStatusToS2",
                                                 0,
                                                 1,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intNumberOfToS = " + IStr(i_intNumberOfToS) +
                                        ", i_intFrequencyToS1 = " + IStr(i_intFrequencyToS1) +
                                        ", i_intFrequencyToS2 = " + IStr(i_intFrequencyToS2) +
                                        ", i_intStatusToS1 = " + IStr(i_intStatusToS1) +
                                        ", i_intStatusToS2 = " + IStr(i_intStatusToS2),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanShake, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      strParameter = "01 000" + IStr(i_intNumberOfToS);
      if(!_SendCommand(i_intModuleID, SE_TOS_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to set number of installed tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      
      strParameter = "20 " + IStr(i_intFrequencyToS1);
      if(!_SendCommand(i_intModuleID, SE_TOS_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to set frequency of tower shaker 1", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      
      strParameter = "21 " + IStr(i_intFrequencyToS2);
      if(!_SendCommand(i_intModuleID, SE_TOS_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to set frequency of tower shaker 2", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      strParameter = "30 " + IStr(i_intStatusToS1);
      if(!_SendCommand(i_intModuleID, SE_TOS_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to set status of tower shaker 1", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      strParameter = "31 " + IStr(i_intStatusToS2);
      if(!_SendCommand(i_intModuleID, SE_TOS_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to set status of tower shaker 2", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // TowerShakerSetParameters

    // --------------------------------------------------------------------------------------
    // function AdvancedOrbitalShakerGetParameters
    // --------------------------------------------------------------------------------------
    function AdvancedOrbitalShakerGetParameters(variable i_intModuleID,
                                                variable i_intSelectedAoS,
                                                variable& o_intFrequency,
                                                variable& o_intStateAoS,
                                                variable& o_intRotationDirection,
                                                variable& o_intMaxFrequency,
                                                variable& o_intAgitationDiameter) variable
    {
      variable strFunctionName("AdvancedOrbitalShakerGetParameters");
      variable strResponse(""), strParameter("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intSelectedAoS,
                                                 "i_intSelectedAoS",
                                                 1,
                                                 2,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intSelectedAoS = " + IStr(i_intSelectedAoS),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanShake, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      o_intFrequency = 88;
      o_intStateAoS = 0;
      o_intRotationDirection = 1;
      o_intMaxFrequency = 200;
      o_intAgitationDiameter = 10;

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      strParameter = IStr(i_intSelectedAoS) + " 20";
      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to get number of installed tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::INTEGER, o_intFrequency, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      strParameter = IStr(i_intSelectedAoS) + " 30";
      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to get frequency of tower shaker 1", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::INTEGER, o_intStateAoS, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      strParameter = IStr(i_intSelectedAoS) + " 40";
      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to get frequency of tower shaker 2", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::INTEGER, o_intRotationDirection, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      strParameter = IStr(i_intSelectedAoS) + " 50";
      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to get status of tower shaker 1", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::INTEGER, o_intMaxFrequency, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      strParameter = IStr(i_intSelectedAoS) + " 60";
      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to get status of tower shaker 2", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::INTEGER, o_intAgitationDiameter, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "o_intFrequency = " + IStr(o_intFrequency) +
                                        ", o_intStateAoS = " + IStr(o_intStateAoS) +
                                        ", o_intRotationDirection = " + IStr(o_intRotationDirection) +
                                        ", o_intMaxFrequency = " + IStr(o_intMaxFrequency) +
                                        ", o_intAgitationDiameter = " + IStr(o_intAgitationDiameter),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // AdvancedOrbitalShakerGetParameters

    // --------------------------------------------------------------------------------------
    // function AdvancedOrbitalShakerSetParameters
    // --------------------------------------------------------------------------------------
    function AdvancedOrbitalShakerSetParameters(variable i_intModuleID,
                                                variable i_intSelectedAoS,
                                                variable i_intFrequency,
                                                variable i_intStateAoS,
                                                variable i_intRotationDirection) variable
    {
      variable strFunctionName("AdvancedOrbitalShakerSetParameters");
      variable strResponse(""), strParameter("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intSelectedAoS,
                                                 "i_intSelectedAoS",
                                                 1,
                                                 2,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intFrequency,
                                                 "i_intFrequency",
                                                 0,
                                                 9999,                // TODO max frequency
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStateAoS,
                                                 "i_intStateAoS",
                                                 0,
                                                 1,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intRotationDirection,
                                                 "i_intRotationDirection",
                                                 RotationDirection::Clockwise,
                                                 RotationDirection::Counterclockwise,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intSelectedAoS = " + IStr(i_intSelectedAoS) +
                                        ", i_intFrequency = " + IStr(i_intFrequency) +
                                        ", i_intStateAoS = " + IStr(i_intStateAoS) +
                                        ", i_intRotationDirection = " + IStr(i_intRotationDirection),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanShake, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      strParameter = IStr(i_intSelectedAoS) + " 20 " + IStr(i_intFrequency);
      if(!_SendCommand(i_intModuleID, SE_TOS_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to set frequency of tower shaker 1", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      strParameter = IStr(i_intSelectedAoS) +  " 30 000" + IStr(i_intStateAoS);
      if(!_SendCommand(i_intModuleID, SE_TOS_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to set status of tower shaker 1", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      strParameter = IStr(i_intSelectedAoS) + " 40 000" + IStr(i_intRotationDirection);
      if(!_SendCommand(i_intModuleID, SE_TOS_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to set status of tower shaker 2", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // AdvancedOrbitalShakerSetParameters

    // --------------------------------------------------------------------------------------
    // function TowerShakerStart
    // --------------------------------------------------------------------------------------
    function TowerShakerStart(variable i_intModuleID,
                              variable i_intStoragePosition) variable
    {
      variable strFunctionName("TowerShakerStart");
      variable intTosParameter(0), intCurrentDevice(0);
      variable strResponse(""), strParameter("");
      string strTempResponse("");

      // check if the tower shaker is initialized, if not initialize
      if(!gThermoScientific_Cytomat_Interface_blnToSInitialized)
      {
        if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);
        if(!_SendCommand(i_intModuleID, LL_INITIALIZE_TOS, "", TIMEOUT_LONG, "", strFunctionName, "Unable to initialize tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
        gThermoScientific_Cytomat_Interface_blnToSInitialized = hslTrue;
      }

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStoragePosition,
                                                 "i_intStoragePosition",
                                                 0,
                                                 gThermoScientific_Cytomat_Interface_arrIntMaxStorageCapacity.GetAt(i_intModuleID),
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intStoragePosition = " + IStr(i_intStoragePosition),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanShake, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // if i_intStoragePosition is set to 0 all available ToS start shaking
      if(i_intStoragePosition == 0)
      {
        if(!_SendCommand(i_intModuleID, LL_SHAKER_START, "", TIMEOUT_LONG, "", strFunctionName, "Unable to start tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      }
      else
      {
        strParameter = IStr(i_intStoragePosition);
        if(!_SendCommand(i_intModuleID, LL_SHAKER_START, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to start tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE); 
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // TowerShakerStart

    // --------------------------------------------------------------------------------------
    // function TowerShakerStop
    // --------------------------------------------------------------------------------------
    function TowerShakerStop(variable i_intModuleID,
                             variable i_intStoragePosition) variable
    {
      variable strFunctionName("TowerShakerStop");
      variable intTosParameter(0), intCurrentDevice(0);
      variable strResponse(""), strParameter("");
      string strTempResponse("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intStoragePosition,
                                                 "i_intStoragePosition",
                                                 0,
                                                 gThermoScientific_Cytomat_Interface_arrIntMaxStorageCapacity.GetAt(i_intModuleID),
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
