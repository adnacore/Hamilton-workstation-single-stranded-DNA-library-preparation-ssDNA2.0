                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanShake, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // if i_intStoragePosition is set to 0, clamps of all available ToS are closed
      if(i_intStoragePosition == 0)
      {
        if(!_SendCommand(i_intModuleID, LL_CLAMP_CLOSE, "", TIMEOUT_LONG, "", strFunctionName, "Unable to close clamping of tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      }
      else
      {
        strParameter = IStr(i_intStoragePosition);
        if(!_SendCommand(i_intModuleID, LL_CLAMP_CLOSE, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to close clamping of tower shaker", strResponse)) return(ASWGLOBAL::BOOL::FALSE); 
      }

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // TowerShakerCloseClamp

    // --------------------------------------------------------------------------------------
    // function AgitationGetParameters
    // --------------------------------------------------------------------------------------
    function AgitationGetParameters(variable i_intModuleID,
                                    variable& o_intFrequency,
                                    variable& o_intAmplitude) variable
    {
      variable strFunctionName("AgitationGetParameters");
      variable intTosParameter(0);
      variable strResponse("");
      string strTempResponse("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanAgitate, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      o_intFrequency = 42;
      o_intAmplitude = 66;

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, CMD_SHAKER_PARAMETER, "", TIMEOUT_LONG, "", strFunctionName, "Unable to get agitation parameters", strResponse)) return(ASWGLOBAL::BOOL::FALSE);
      if(!_ProcessResponse(i_intModuleID, strResponse, "pb", ResponseType::STRING, strTempResponse, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      // split the string response of strukture [<Frequency> <Amplitude>] into separate integer values
      o_intFrequency = IVal(strTempResponse.Mid(0, strTempResponse.Find(" ")));
      o_intAmplitude = IVal(strTempResponse.Mid(strTempResponse.Find(" "), strTempResponse.GetLength()));

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "o_intFrequency = " + IStr(o_intFrequency) +
                                        ", o_intAmplitude = " + IStr(o_intAmplitude),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // AgitationGetParameters

    // --------------------------------------------------------------------------------------
    // function AgitationSetParameters
    // --------------------------------------------------------------------------------------
    function AgitationSetParameters(variable i_intModuleID,
                                    variable i_intFrequency,
                                    variable i_intAmplitude) variable
    {
      variable strFunctionName("AgitationSetParameters");
      variable intTosParameter(0), intCurrentDevice(0);
      variable strResponse(""), strParameter("");
      string strTempResponse("");

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intFrequency,
                                                 "i_intFrequency",
                                                 0,
                                                 999,                // TODO max frequency
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      if(Hamilton_DriverTools::CheckIntegerRange(i_intAmplitude,
                                                 "i_intAmplitude",
                                                 0,
                                                 999,                // TODO max amplitude
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID) +
                                        ", i_intFrequency = " + IStr(i_intFrequency) +
                                        ", i_intAmplitude = " + IStr(i_intAmplitude),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanAgitate, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      strParameter = IStr(i_intFrequency) + " " + IStr(i_intAmplitude);
      if(!_SendCommand(i_intModuleID, SE_TOS_PARAMETER, strParameter, TIMEOUT_LONG, "", strFunctionName, "Unable to set agitation parameters", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // AgitationSetParameters

    // --------------------------------------------------------------------------------------
    // function AgitationStart
    // --------------------------------------------------------------------------------------
    function AgitationStart(variable i_intModuleID) variable
    {
      variable strFunctionName("AgitationStart");
      variable intCurrentDevice(0);
      variable strResponse("");

      if(_Simulated(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::TRUE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_SHORT, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      // move all motors to the predefined wait positions
      if(!_SendCommand(i_intModuleID, LL_MOVE_WP, "", TIMEOUT_LONG, "", strFunctionName, "Unable to move motors to defined wait positions", strResponse)) return(ASWGLOBAL::BOOL::FALSE);   // TODO check if this step is necessary

      if(Hamilton_DriverTools::CheckIntegerRange(i_intModuleID,
                                                 "i_intModuleID",
                                                 0,
                                                 Hamilton_SerialInterface::MAXIMUM_MODULEID,
                                                 strFunctionName,
                                                 gThermoScientific_Cytomat_Interface_strModuleName) == ASWGLOBAL::BOOL::FALSE) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::START,
                                        TRACE_LEVEL_DEBUG,
                                        "i_intModuleID = " + IStr(i_intModuleID),
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);

      if(!_Initialized(i_intModuleID, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);
      
      if(!_DeviceSupported(i_intModuleID, gThermoScientific_Cytomat_Interface_arrIntCanAgitate, strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_WaitForReady(i_intModuleID, TIMEOUT_LONG, "Waiting for device to accept command", strFunctionName)) return(ASWGLOBAL::BOOL::FALSE);

      if(!_SendCommand(i_intModuleID, LL_SHAKER_START, "", TIMEOUT_LONG, "", strFunctionName, "Unable to start agitation", strResponse)) return(ASWGLOBAL::BOOL::FALSE);

      Hamilton_DriverTools::StatusTrace(Hamilton_DriverTools::ACTION::COMPLETE,
                                        TRACE_LEVEL_DEBUG,
                                        "",
                                        strFunctionName,
                                        gThermoScientific_Cytomat_Interface_intTraceLevel,
                                        gThermoScientific_Cytomat_Interface_strModuleName);
      return(ASWGLOBAL::BOOL::TRUE);
    } // AgitationStart

